<UserControl x:Class="IRacingOverlay.App.Widgets.CircuitMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
             xmlns:loc="clr-namespace:IRacingOverlay.App.Localization">
    <!-- The track's real shape, learned from a lap driven there, with every car on it. Until the
         shape is known, a line saying a clean lap will draw it. -->
    <ov:WidgetFrame x:Name="Frame" Padding="6" Title="{loc:T widget.CircuitMap.name}">
        <Grid x:Name="MapArea" Width="240" Height="240" SizeChanged="OnMapAreaSizeChanged">
            <!-- A wide dark band under a thin light line reads as tarmac against any backdrop. -->
            <Path x:Name="TrackBed" Stroke="#CC0A0C0F" StrokeThickness="9" StrokeLineJoin="Round"/>
            <Path x:Name="TrackLine" Stroke="#B3B4BCC8" StrokeThickness="3" StrokeLineJoin="Round"/>
            <Line x:Name="StartFinish" Stroke="{StaticResource Row.PlayerMarker}" StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
            <Canvas x:Name="MarkerLayer"/>
            <TextBlock x:Name="Learning" Foreground="#B4BCC8" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
        </Grid>
    </ov:WidgetFrame>
</UserControl>
