<ov:OverlayWindowBase x:Class="IRacingOverlay.App.Widgets.PedalTraceWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
        xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
        Title="Pedals">
    <Grid>
        <!-- Width from the visible blocks (the trace has its own), so hiding one narrows the widget;
             the height is the design's. -->
        <ov:ScalablePanel x:Name="Scaler" ShowButtons="{Binding IsEditMode}" PersistenceKey="Widget.PedalTrace"
                          DesignHeight="110">
            <w:PedalTracePanel/>
        </ov:ScalablePanel>
        <Border Style="{StaticResource EditFrame}"/>
    </Grid>
</ov:OverlayWindowBase>
