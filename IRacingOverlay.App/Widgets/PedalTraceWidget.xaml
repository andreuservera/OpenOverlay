<ov:OverlayWindowBase x:Class="IRacingOverlay.App.Widgets.PedalTraceWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
        xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
        Title="Pedals">
    <Grid>
        <!-- The trace plot fills whatever space it is given, so the panel needs a design size to
             measure against: without one the chart would collapse to its caption. -->
        <ov:ScalablePanel x:Name="Scaler" ShowButtons="{Binding IsEditMode}" PersistenceKey="Widget.PedalTrace"
                          DesignWidth="340" DesignHeight="110">
            <w:PedalTracePanel/>
        </ov:ScalablePanel>
        <Border Style="{StaticResource EditFrame}"/>
    </Grid>
</ov:OverlayWindowBase>
