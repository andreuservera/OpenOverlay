<UserControl x:Class="IRacingOverlay.App.Widgets.TrackMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <DrawingBrush x:Key="Chequer" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1FFFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,4,4"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#BFF2F5F8">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,2,2"/>
                                <RectangleGeometry Rect="2,2,2,2"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="FinishLine" TargetType="Rectangle">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Fill" Value="{StaticResource Chequer}"/>
        </Style>
    </UserControl.Resources>
    <!-- The lap as a tunnel: start/finish at the left end, back at start/finish at the right, and
         nothing drawn inside but the start/finish chequers and the cars, which fill it top to
         bottom. The player's car sits in a soft column of light. -->
    <Border x:Name="Frame" Style="{StaticResource OverlayPanel}" Padding="0,1">
        <Grid x:Name="MapArea" Height="22" SizeChanged="OnMapAreaSizeChanged">
            <!-- Start/finish: a chequered strip at each end, since the lap starts at the left and
                 finishes back on the same line at the right. Flush with the panel's edges; the
                 map is clipped to the panel's rounded corners so they follow its outline. -->
            <Rectangle Style="{StaticResource FinishLine}" HorizontalAlignment="Left"/>
            <Rectangle Style="{StaticResource FinishLine}" HorizontalAlignment="Right"/>
            <!-- "You": a soft grey light fading out to either side, narrowed to a column that only
                 just clears the disc, with a short bright tick at the top and bottom of the tunnel
                 so the column still reads in a bunched pack. -->
            <Grid x:Name="PlayerAura" Width="28" HorizontalAlignment="Left" Visibility="Collapsed">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00C4CCD4" Offset="0"/>
                            <GradientStop Color="#47C4CCD4" Offset="0.3"/>
                            <GradientStop Color="#47C4CCD4" Offset="0.7"/>
                            <GradientStop Color="#00C4CCD4" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="12" Height="2" VerticalAlignment="Top" Fill="{StaticResource Row.PlayerOutline}" RadiusX="1" RadiusY="1"/>
                <Rectangle Width="12" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource Row.PlayerOutline}" RadiusX="1" RadiusY="1"/>
            </Grid>
            <Canvas x:Name="MarkerLayer"/>
        </Grid>
    </Border>
</UserControl>
