<UserControl x:Class="IRacingOverlay.App.Widgets.TrackMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="16,9">
        <StackPanel>
            <TextBlock Text="TRACK MAP" Style="{StaticResource PanelTitle}" Margin="0,0,0,7"/>
            <Grid x:Name="MapArea" Height="30">
                <Rectangle Height="2" Fill="{StaticResource Surface.Track}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                           RadiusX="1" RadiusY="1"/>
                <Rectangle Width="2" Fill="{StaticResource State.Info}" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
                <Canvas x:Name="MarkerLayer"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
