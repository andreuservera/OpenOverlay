<UserControl x:Class="IRacingOverlay.App.Widgets.TrackMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource OverlayPanel}" Padding="16,9">
        <StackPanel>
            <Grid x:Name="MapArea" Height="30">
                <Rectangle Height="2" Fill="{StaticResource Surface.Track}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                           RadiusX="1" RadiusY="1"/>
                <!-- Start/finish line: a landmark, not a state, so neutral ink. -->
                <Rectangle Width="2" Fill="{StaticResource Text.Muted}" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                           RadiusX="1" RadiusY="1"/>
                <Canvas x:Name="MarkerLayer"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
