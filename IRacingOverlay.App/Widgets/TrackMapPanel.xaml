<UserControl x:Class="IRacingOverlay.App.Widgets.TrackMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="14,8">
        <StackPanel>
            <TextBlock Text="TRACK MAP" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
            <Grid x:Name="MapArea" Height="30">
                <Rectangle Height="2" Fill="#3A3A3A" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                <Rectangle Width="2" Fill="#8FD3FF" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
                <Canvas x:Name="MarkerLayer"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
