<ov:OverlayWindowBase x:Class="IRacingOverlay.App.Widgets.FuelWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
        xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
        Title="Fuel">
    <Grid>
        <ov:ScalablePanel x:Name="Scaler" ShowButtons="{Binding IsEditMode}" PersistenceKey="Widget.Fuel">
            <w:FuelPanel/>
        </ov:ScalablePanel>
        <Border Style="{StaticResource EditFrame}"/>
    </Grid>
</ov:OverlayWindowBase>
