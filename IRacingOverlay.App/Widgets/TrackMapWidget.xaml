<ov:OverlayWindowBase x:Class="IRacingOverlay.App.Widgets.TrackMapWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
        xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
        Title="Track Map">
    <Grid>
        <!-- The map bar has no natural width of its own — it is a stretched track line, so left to
             measure itself it would collapse to the width of the "TRACK MAP" caption. 700 is its
             design width at level M; every other level is that times the level's factor. -->
        <ov:ScalablePanel x:Name="Scaler" ShowButtons="{Binding IsEditMode}" PersistenceKey="Widget.TrackMap"
                          DesignWidth="700">
            <w:TrackMapPanel/>
        </ov:ScalablePanel>
        <Border Style="{StaticResource EditFrame}"/>
    </Grid>
</ov:OverlayWindowBase>
