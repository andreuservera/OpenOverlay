<UserControl x:Class="IRacingOverlay.App.Widgets.PedalTracePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
             x:Name="Root">
    <Border Style="{StaticResource OverlayPanel}" Padding="12,10">
        <!-- Gauges and plot share one row, so each bar's 0-100 % travel lines up with the same
             0-100 % on the trace beside it; the pedal letters sit in a row of their own below. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="ThrottleTrack" Grid.Column="0" Width="20" Margin="0,0,5,0" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}">
                <Rectangle x:Name="ThrottleFill" Fill="{StaticResource State.Positive}" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0"/></Rectangle.RenderTransform>
                </Rectangle>
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="T" Style="{StaticResource UnitLabel}" Foreground="{StaticResource State.Positive}"
                       HorizontalAlignment="Center" Margin="0,3,5,0"/>
            <Border x:Name="BrakeTrack" Grid.Column="1" Width="20" Margin="0,0,5,0" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}">
                <Rectangle x:Name="BrakeFill" Fill="{StaticResource State.Critical}" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0"/></Rectangle.RenderTransform>
                </Rectangle>
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="B" Style="{StaticResource UnitLabel}" Foreground="{StaticResource State.Critical}"
                       HorizontalAlignment="Center" Margin="0,3,5,0"/>
            <Border x:Name="ClutchTrack" Grid.Column="2" Width="20" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}">
                <Rectangle x:Name="ClutchFill" Fill="{StaticResource State.Info}" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0"/></Rectangle.RenderTransform>
                </Rectangle>
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="C" Style="{StaticResource UnitLabel}" Foreground="{StaticResource State.Info}"
                       HorizontalAlignment="Center" Margin="0,3,0,0"/>

            <!-- The plot sits on its own inset well rather than directly on the panel: the darker
                 rounded field makes the traces read as a chart, and matches the rounded gauge
                 tracks beside it instead of being the one square-cornered element in the panel. -->
            <Border Grid.Column="3" Margin="12,0,0,0" Background="{StaticResource Surface.Inset}" CornerRadius="{StaticResource Radius.Chip}">
                <Grid>
                    <!-- Half-travel guide: the one reference line worth drawing, and faint. -->
                    <Rectangle Height="1" VerticalAlignment="Center" Fill="{StaticResource Surface.DividerFade}" Opacity="0.6"/>
                    <w:PedalTraceGraph x:Name="Trace" ThrottleBrush="{StaticResource State.Positive}" ClutchBrush="{StaticResource State.Info}"
                                       BrakeBrush="{StaticResource State.Critical}" AbsBrush="{StaticResource State.Accent}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
