<UserControl x:Class="IRacingOverlay.App.Widgets.PedalTracePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
             x:Name="Root">
    <Border Style="{StaticResource OverlayPanel}" Padding="12,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="20" Margin="0,0,5,0">
                        <Border x:Name="ThrottleTrack" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}" Height="90">
                            <Grid VerticalAlignment="Stretch">
                                <Rectangle x:Name="ThrottleFill" Fill="{StaticResource State.Positive}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0"/></Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Border>
                        <TextBlock Text="T" Style="{StaticResource UnitLabel}" Foreground="{StaticResource State.Positive}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Width="20" Margin="0,0,5,0">
                        <Border x:Name="BrakeTrack" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}" Height="90">
                            <Grid VerticalAlignment="Stretch">
                                <Rectangle x:Name="BrakeFill" Fill="{StaticResource State.Critical}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0"/></Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Border>
                        <TextBlock Text="B" Style="{StaticResource UnitLabel}" Foreground="{StaticResource State.Critical}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Width="20">
                        <Border x:Name="ClutchTrack" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}" Height="90">
                            <Grid VerticalAlignment="Stretch">
                                <Rectangle x:Name="ClutchFill" Fill="{StaticResource State.Info}" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0"/></Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Border>
                        <TextBlock Text="C" Style="{StaticResource UnitLabel}" Foreground="{StaticResource State.Info}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- The plot sits on its own inset well rather than directly on the panel: the darker
                     rounded field makes the traces read as a chart, and matches the rounded gauge
                     tracks beside it instead of being the one square-cornered element in the panel. -->
                <Border Grid.Row="1" Background="{StaticResource Surface.Inset}" CornerRadius="{StaticResource Radius.Chip}">
                    <Grid>
                        <!-- Half-travel guide: the one reference line worth drawing, and faint. -->
                        <Rectangle Height="1" VerticalAlignment="Center" Fill="{StaticResource Surface.DividerFade}" Opacity="0.6"/>
                        <w:PedalTraceGraph x:Name="Trace" ThrottleBrush="{StaticResource State.Positive}" ClutchBrush="{StaticResource State.Info}"
                                           BrakeBrush="{StaticResource State.Critical}" AbsBrush="{StaticResource State.Accent}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
