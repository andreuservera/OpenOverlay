<UserControl x:Class="IRacingOverlay.App.Widgets.PedalTracePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="12,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="PEDALS" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="20" Margin="0,0,5,0">
                        <Border x:Name="ThrottleTrack" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}" Height="90">
                            <Grid VerticalAlignment="Stretch">
                                <Rectangle x:Name="ThrottleFill" Fill="{StaticResource State.Positive}" VerticalAlignment="Bottom" Height="0"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="T" Style="{StaticResource UnitLabel}" Foreground="{StaticResource State.Positive}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Width="20" Margin="0,0,5,0">
                        <Border x:Name="BrakeTrack" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}" Height="90">
                            <Grid VerticalAlignment="Stretch">
                                <Rectangle x:Name="BrakeFill" Fill="{StaticResource State.Critical}" VerticalAlignment="Bottom" Height="0"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="B" Style="{StaticResource UnitLabel}" Foreground="{StaticResource State.Critical}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Width="20">
                        <Border x:Name="ClutchTrack" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}" Height="90">
                            <Grid VerticalAlignment="Stretch">
                                <Rectangle x:Name="ClutchFill" Fill="{StaticResource State.Info}" VerticalAlignment="Bottom" Height="0"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="C" Style="{StaticResource UnitLabel}" Foreground="{StaticResource State.Info}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="THROTTLE / BRAKE TRACE" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                <!-- The plot sits on its own inset well rather than directly on the panel: the darker
                     rounded field makes the traces read as a chart, and matches the rounded gauge
                     tracks beside it instead of being the one square-cornered element in the panel. -->
                <Border Grid.Row="1" Background="#0B0D10" CornerRadius="{StaticResource Radius.Chip}">
                    <Canvas x:Name="TraceCanvas" ClipToBounds="True"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
