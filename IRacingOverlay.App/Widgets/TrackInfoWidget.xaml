<ov:OverlayWindowBase x:Class="IRacingOverlay.App.Widgets.TrackInfoWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
        xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
        Title="Track Info" Width="640" Height="70" MinWidth="480" MinHeight="60">
    <Border BorderBrush="Orange" BorderThickness="0">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <ov:ScalablePanel x:Name="Scaler" ShowButtons="{Binding IsEditMode}" PersistenceKey="Widget.TrackInfo">
            <w:TrackInfoPanel/>
        </ov:ScalablePanel>
    </Border>
</ov:OverlayWindowBase>
