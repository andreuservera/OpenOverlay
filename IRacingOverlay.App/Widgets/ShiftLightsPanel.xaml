<UserControl x:Class="IRacingOverlay.App.Widgets.ShiftLightsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Segments are added in code-behind, one per CockpitState.ShiftLightCount, so the count only
         needs to change in one place. The recessed track makes the unlit strip read as hardware. -->
    <Border Background="{StaticResource Surface.Inset}" CornerRadius="4" Padding="3" HorizontalAlignment="Center">
        <StackPanel x:Name="LightsStack" Orientation="Horizontal"/>
    </Border>
</UserControl>
