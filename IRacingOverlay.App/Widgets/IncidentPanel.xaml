<UserControl x:Class="IRacingOverlay.App.Widgets.IncidentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IRacingOverlay.App.Localization"
             x:Name="Root"
             xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay">
    <!-- Your count, the team's beside it in a team race, and the session's limit when it has one:
         "4 / 17" on one baseline, the limit smaller and muted, with a thin bar under it filling
         towards the limit in the severity colour. Captions only appear when there are two numbers
         to tell apart. A new incident briefly swaps the title for what it was ("2x LOSS OF
         CONTROL") and washes the panel in its colour. -->
    <UserControl.Resources>
        <Style x:Key="Count" TargetType="TextBlock" BasedOn="{StaticResource DisplayValueSmall}">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="LineHeight" Value="32"/>
        </Style>
        <!-- "/ 17": the limit, on the count's baseline. -->
        <Style x:Key="LimitRun" TargetType="Run">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>
    </UserControl.Resources>
    <ov:WidgetFrame Padding="12,6,12,9" Title="{loc:T widget.Incident.name}">
        <Grid>
            <!-- Under the text, out to the panel's edges (the negative margin undoes the padding). -->
            <Border x:Name="AlertWash" Margin="-12,-6,-12,-9" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
                    Opacity="0" IsHitTestVisible="False"/>
            <StackPanel MinWidth="120">
                <!-- Title and alert share one slot. The hidden sizer holds the longest alert, so the
                     panel is always that wide and never resizes when one appears. -->
                <Grid Margin="0,0,0,1">
                    <TextBlock Text="{loc:T incident.2xLossOfControl}" Style="{StaticResource ColumnHeader}" FontWeight="Bold" Visibility="Hidden"/>
                    <!-- With the header on, the name is already up there: the slot stays for the alerts. -->
                    <TextBlock x:Name="TitleText" Text="{loc:T incident.incidents}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ColumnHeader}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding (ov:WidgetFrame.ShowHeader), RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="AlertText" Text="" Style="{StaticResource ColumnHeader}" FontWeight="Bold" Opacity="0"/>
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock x:Name="MyCaption" Text="{loc:T incident.you}" Style="{StaticResource ColumnHeader}" FontSize="11" Visibility="Collapsed"/>
                        <TextBlock x:Name="MyCountText" Style="{StaticResource Count}" RenderTransformOrigin="0.3,0.6">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="MyCountScale"/>
                            </TextBlock.RenderTransform>
                            <Run x:Name="MyCountRun" Text="0"/><Run x:Name="MyLimitRun" Text="" Style="{StaticResource LimitRun}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel x:Name="TeamBlock" Margin="20,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="{loc:T incident.team}" Style="{StaticResource ColumnHeader}" FontSize="11"/>
                        <TextBlock x:Name="TeamCountText" Style="{StaticResource Count}">
                            <Run x:Name="TeamCountRun" Text="0"/><Run x:Name="TeamLimitRun" Text="" Style="{StaticResource LimitRun}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <!-- How close the counted total is to the limit; only when there is one. -->
                <Border x:Name="LimitTrack" Style="{StaticResource MeterTrack}" Height="4" Margin="0,5,0,0" Visibility="Collapsed">
                    <Rectangle x:Name="LimitFill" HorizontalAlignment="Left" Width="0" RadiusX="2" RadiusY="2"
                               Fill="{StaticResource Text.Secondary}"/>
                </Border>
            </StackPanel>
        </Grid>
    </ov:WidgetFrame>
</UserControl>
