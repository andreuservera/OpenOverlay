<UserControl x:Class="IRacingOverlay.App.Widgets.IncidentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Horizontal padding rebalanced against the narrower caption cut, so the panel keeps its
         original footprint. -->
    <Border Style="{StaticResource OverlayPanel}" Padding="14.5,10">
        <StackPanel>
            <TextBlock Text="INCIDENTS" Style="{StaticResource PanelTitle}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MyCountText" Text="0" Style="{StaticResource DisplayValueSmall}"/>
                <TextBlock x:Name="TeamCountText" Text="" Style="{StaticResource UnitLabel}"
                           VerticalAlignment="Bottom" Margin="8,0,0,4"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
