<UserControl x:Class="IRacingOverlay.App.Widgets.IncidentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="12,10">
        <StackPanel>
            <TextBlock Text="INCIDENTS" Style="{StaticResource PanelTitle}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MyCountText" Text="0" Style="{StaticResource DisplayValue}"
                           FontSize="{StaticResource Type.DisplaySmall}"/>
                <TextBlock x:Name="TeamCountText" Text="" Style="{StaticResource UnitLabel}"
                           VerticalAlignment="Bottom" Margin="8,0,0,4"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
