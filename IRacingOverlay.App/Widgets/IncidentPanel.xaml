<UserControl x:Class="IRacingOverlay.App.Widgets.IncidentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="10">
        <StackPanel>
            <TextBlock Text="INCIDENTS" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MyCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                <TextBlock x:Name="TeamCountText" Text="" Foreground="#888888" FontSize="13" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
