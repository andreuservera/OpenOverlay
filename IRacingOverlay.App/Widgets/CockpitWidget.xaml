<ov:OverlayWindowBase x:Class="IRacingOverlay.App.Widgets.CockpitWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
        Title="Cockpit" Width="420" Height="220" MinWidth="300" MinHeight="150">
    <Border BorderBrush="Orange" BorderThickness="0">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border Background="#E6141414" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>

                <!-- Left proximity bar: fills from the bottom as a car alongside on the left gets closer -->
                <Border x:Name="LeftProximityTrack" Grid.Column="0" Background="#221E1A" CornerRadius="3" Margin="2,0">
                    <Grid VerticalAlignment="Stretch">
                        <Rectangle x:Name="LeftProximityFill" Fill="#FFB000" VerticalAlignment="Bottom" Height="0"/>
                    </Grid>
                </Border>

                <!-- TC bar: glows/flashes green when traction control engages -->
                <Border x:Name="TcBar" Grid.Column="1" Background="#1E2E1E" CornerRadius="3" Margin="2,0"/>

                <!-- Center: shift lights + big gear letter -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel x:Name="ShiftLightsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Ellipse x:Name="ShiftLight0" Width="20" Height="20" Fill="#2A2A2A" Margin="3"/>
                        <Ellipse x:Name="ShiftLight1" Width="20" Height="20" Fill="#2A2A2A" Margin="3"/>
                        <Ellipse x:Name="ShiftLight2" Width="20" Height="20" Fill="#2A2A2A" Margin="3"/>
                        <Ellipse x:Name="ShiftLight3" Width="20" Height="20" Fill="#2A2A2A" Margin="3"/>
                        <Ellipse x:Name="ShiftLight4" Width="20" Height="20" Fill="#2A2A2A" Margin="3"/>
                    </StackPanel>
                    <TextBlock x:Name="GearText" Text="–" FontSize="88" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" FontFamily="Consolas"/>
                </StackPanel>

                <!-- ABS bar: glows/flashes red when ABS engages -->
                <Border x:Name="AbsBar" Grid.Column="3" Background="#2E1E1E" CornerRadius="3" Margin="2,0"/>

                <!-- Right proximity bar -->
                <Border x:Name="RightProximityTrack" Grid.Column="4" Background="#221E1A" CornerRadius="3" Margin="2,0">
                    <Grid VerticalAlignment="Stretch">
                        <Rectangle x:Name="RightProximityFill" Fill="#FFB000" VerticalAlignment="Bottom" Height="0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</ov:OverlayWindowBase>
