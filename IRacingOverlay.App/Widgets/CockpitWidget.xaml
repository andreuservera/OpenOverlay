<ov:OverlayWindowBase x:Class="IRacingOverlay.App.Widgets.CockpitWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
        xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
        Title="Cockpit">
    <Border BorderBrush="Orange" BorderThickness="0">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <!-- 310x150 is CockpitPanel's own measured natural size (Auto-sized columns, no slack — see
             CockpitPanel.xaml), so there is no dead space baked into the design canvas. Declaring it
             here rather than wrapping the panel in a Viewbox means the cluster is laid out once and
             then scaled by the level's LayoutTransform: type stays crisply hinted at every level
             instead of being a stretched bitmap, and the aspect ratio is fixed by construction —
             there is no longer any way for the user to stretch it out of proportion. -->
        <ov:ScalablePanel x:Name="Scaler" ShowButtons="{Binding IsEditMode}" PersistenceKey="Widget.Cockpit"
                          DesignWidth="310" DesignHeight="150">
            <w:CockpitPanel/>
        </ov:ScalablePanel>
    </Border>
</ov:OverlayWindowBase>
