<ov:OverlayWindowBase x:Class="IRacingOverlay.App.Widgets.CockpitWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
        xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
        Title="Cockpit" Width="310" Height="150" MinWidth="155" MinHeight="75">
    <Border BorderBrush="Orange" BorderThickness="0">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <!-- The Viewbox itself must NOT have an explicit Width/Height — that would fix its own
             rendered size regardless of how big the window becomes, which is exactly what made the
             window resize while the visible content stayed pinned at a constant size (the resize
             grip correctly followed the window corner; the content just never grew to meet it). The
             fixed 310x150 size instead belongs to the Grid *inside* the Viewbox, which only exists to
             give Stretch="Uniform" a reference aspect ratio — it's CockpitPanel's own measured
             natural size (Auto-sized columns, no slack — see CockpitPanel.xaml), not a guessed
             constant, so there's no leftover dead space baked into the canvas itself. The Viewbox
             itself is left to stretch and fill whatever space ScalablePanel/the window actually
             gives it, so resizing the window (grip aspect-locked to the same ratio via
             OverlayWindowBase.FixedAspectRatio) correctly rescales the whole cluster with it, with
             no letterboxing gap. No +/- zoom buttons (ShowButtons=False, no PersistenceKey) —
             resizing the window itself is the one way to make this bigger/smaller, unlike other
             widgets. -->
        <ov:ScalablePanel x:Name="Scaler" ShowButtons="False">
            <Viewbox Stretch="Uniform">
                <Grid Width="310" Height="150">
                    <w:CockpitPanel/>
                </Grid>
            </Viewbox>
        </ov:ScalablePanel>
    </Border>
</ov:OverlayWindowBase>
