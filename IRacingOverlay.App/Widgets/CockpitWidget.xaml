<ov:OverlayWindowBase x:Class="IRacingOverlay.App.Widgets.CockpitWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
        xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
        Title="Cockpit">
    <Grid>
        <!-- No design size: the dashboard is as wide as the modules it shows, and the window takes
             that size at every scale level. -->
        <ov:ScalablePanel x:Name="Scaler" ShowButtons="{Binding IsEditMode}" PersistenceKey="Widget.Cockpit">
            <w:CockpitPanel/>
        </ov:ScalablePanel>
        <Border Style="{StaticResource EditFrame}"/>
    </Grid>
</ov:OverlayWindowBase>
