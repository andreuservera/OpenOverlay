<UserControl x:Class="IRacingOverlay.App.Widgets.TrackInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Every field in this bar is the same shape — caption, then value — so the reading rhythm
             stays constant all the way across and the eye can jump straight to the one it wants. -->
        <Style x:Key="BarField" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>
        <Style x:Key="BarCaption" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="BarValue" TargetType="TextBlock" BasedOn="{StaticResource DataCell}">
            <Setter Property="FontFamily" Value="{DynamicResource Theme.DataFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BarSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource Surface.Divider}"/>
            <Setter Property="Margin" Value="0,2,18,2"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="16,9">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <!-- Capped + trimmed: this bar is one long horizontal StackPanel, so an unusually long
                 circuit name would otherwise push the session clock off the right-hand end. -->
            <TextBlock x:Name="TrackNameText" Text="—" FontSize="{StaticResource Type.Value}" FontWeight="Bold"
                       Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"
                       MaxWidth="220" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SessionLabelText" Text="—" Style="{StaticResource PanelTitle}"
                       VerticalAlignment="Center" Margin="10,2,0,0"/>

            <Rectangle Style="{StaticResource BarSeparator}" Margin="18,2,18,2"/>

            <StackPanel Style="{StaticResource BarField}">
                <TextBlock Text="AIR" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="AirTempText" Text="—" Style="{StaticResource BarValue}" Foreground="{StaticResource State.Accent}"/>
            </StackPanel>

            <StackPanel Style="{StaticResource BarField}">
                <TextBlock Text="TRACK" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="TrackTempText" Text="—" Style="{StaticResource BarValue}" Foreground="{StaticResource State.Accent}"/>
            </StackPanel>

            <StackPanel Style="{StaticResource BarField}">
                <TextBlock Text="WIND" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="WindText" Text="—" Style="{StaticResource BarValue}" Foreground="{StaticResource State.Info}"/>
            </StackPanel>

            <StackPanel Style="{StaticResource BarField}">
                <TextBlock Text="HUMIDITY" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="HumidityText" Text="—" Style="{StaticResource BarValue}" Foreground="{StaticResource State.Info}"/>
            </StackPanel>

            <StackPanel Style="{StaticResource BarField}">
                <TextBlock Text="USAGE" Style="{StaticResource BarCaption}"/>
                <StackPanel x:Name="TrackUsageBar" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Rectangle Width="5" Height="12" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="{StaticResource Surface.Track}"/>
                    <Rectangle Width="5" Height="12" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="{StaticResource Surface.Track}"/>
                    <Rectangle Width="5" Height="12" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="{StaticResource Surface.Track}"/>
                    <Rectangle Width="5" Height="12" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="{StaticResource Surface.Track}"/>
                    <Rectangle Width="5" Height="12" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="{StaticResource Surface.Track}"/>
                    <Rectangle Width="5" Height="12" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="{StaticResource Surface.Track}"/>
                    <Rectangle Width="5" Height="12" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="{StaticResource Surface.Track}"/>
                    <Rectangle Width="5" Height="12" RadiusX="1" RadiusY="1" Fill="{StaticResource Surface.Track}"/>
                </StackPanel>
                <TextBlock x:Name="TrackUsageText" Text="—" Style="{StaticResource BarValue}" Foreground="{StaticResource State.Special}"/>
            </StackPanel>

            <Rectangle Style="{StaticResource BarSeparator}"/>

            <!-- Time/laps remaining are what a driver actually glances up for mid-stint, so they end
                 the bar in primary white rather than in the muted color the weather fields use. -->
            <StackPanel Style="{StaticResource BarField}">
                <TextBlock Text="TIME LEFT" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="TimeRemainingText" Text="—" Style="{StaticResource ValueText}"
                           FontSize="{StaticResource Type.Body}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Style="{StaticResource BarField}" Margin="0">
                <TextBlock Text="LAPS LEFT" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="LapsRemainingText" Text="—" Style="{StaticResource ValueText}"
                           FontSize="{StaticResource Type.Body}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
