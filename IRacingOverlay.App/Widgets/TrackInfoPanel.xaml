<UserControl x:Class="IRacingOverlay.App.Widgets.TrackInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
             x:Name="Root">
    <!-- The fields are laid out by the code-behind, in the order and with the visibility the
         options give: a separator wherever neighbouring fields belong to different groups (track
         and session, conditions, timing), and a field's gap to the one before it otherwise. -->
    <UserControl.Resources>
        <!-- Every field in this bar is the same shape — caption, then value — so the reading rhythm
             stays constant all the way across and the eye can jump straight to the one it wants.
             The gutter is a little wider than the old 18: the condensed caption cut freed the
             room, and the bar keeps its original length. -->
        <Style x:Key="BarField" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BarCaption" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- The weather fields wear the Weather widget's icons instead of a caption; the tooltip
             still names the reading. -->
        <Style x:Key="BarGlyph" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Fill" Value="{StaticResource Text.Secondary}"/>
        </Style>
        <Style x:Key="BarValue" TargetType="TextBlock" BasedOn="{StaticResource DataCell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BarSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource Surface.Divider}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="UsageSegment" TargetType="Rectangle">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Fill" Value="{StaticResource Surface.Track}"/>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource OverlayPanel}" Padding="16,9">
        <StackPanel x:Name="Bar" Orientation="Horizontal" HorizontalAlignment="Center">
            <!-- Capped + trimmed: this bar is one long horizontal row, so an unusually long
                 circuit name would otherwise push the session clock off the right-hand end. -->
            <TextBlock x:Name="TrackNameText" Text="—" Style="{StaticResource ValueText}" VerticalAlignment="Center"
                       MaxWidth="220" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SessionLabelText" Text="—" Style="{StaticResource PanelTitle}"
                       VerticalAlignment="Center" Margin="0,2,0,0"/>

            <!-- Weather is context, read on purpose rather than at a glance: secondary ink
                 throughout, with colour left to the one field here that carries a state (usage). -->
            <StackPanel x:Name="FieldAirTemp" Style="{StaticResource BarField}" ToolTip="Air temperature">
                <w:WeatherIcon x:Name="SkyIcon" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,5,0"
                               SunBrush="{StaticResource State.Accent}" MoonBrush="{StaticResource Text.Primary}"
                               CloudBrush="{StaticResource Text.Secondary}" CloudShadeBrush="{StaticResource Text.Muted}"
                               RainBrush="{StaticResource State.Info}"/>
                <TextBlock x:Name="AirTempText" Text="—" Style="{StaticResource BarValue}"/>
            </StackPanel>

            <StackPanel x:Name="FieldTrackTemp" Style="{StaticResource BarField}" ToolTip="Track temperature">
                <Path Style="{StaticResource BarGlyph}" Data="{StaticResource Icon.Road}"/>
                <TextBlock x:Name="TrackTempText" Text="—" Style="{StaticResource BarValue}"/>
            </StackPanel>

            <StackPanel x:Name="FieldWind" Style="{StaticResource BarField}" ToolTip="Wind">
                <Path Style="{StaticResource BarGlyph}" Data="{StaticResource Icon.Wind}" Height="13" Fill="{x:Null}"
                      Stroke="{StaticResource Text.Secondary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock x:Name="WindText" Text="—" Style="{StaticResource BarValue}"/>
            </StackPanel>

            <StackPanel x:Name="FieldHumidity" Style="{StaticResource BarField}" ToolTip="Relative humidity">
                <Path Style="{StaticResource BarGlyph}" Data="{StaticResource Icon.Drop}" Height="13"/>
                <TextBlock x:Name="HumidityText" Text="—" Style="{StaticResource BarValue}"/>
            </StackPanel>

            <StackPanel x:Name="FieldTrackUsage" Style="{StaticResource BarField}">
                <TextBlock Text="USAGE" Style="{StaticResource BarCaption}"/>
                <StackPanel x:Name="TrackUsageBar" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}" Margin="0"/>
                </StackPanel>
                <TextBlock x:Name="TrackUsageText" Text="—" Style="{StaticResource BarValue}"/>
            </StackPanel>

            <!-- Time left and the lap count are what a driver actually glances up for mid-stint, so
                 they end the bar by default, in primary ink rather than the secondary the weather
                 fields use. -->
            <StackPanel x:Name="FieldTimeLeft" Style="{StaticResource BarField}">
                <TextBlock Text="TIME LEFT" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="TimeRemainingText" Text="—" Style="{StaticResource ValueTextSmall}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="FieldLap" Style="{StaticResource BarField}">
                <TextBlock Text="LAP" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="LapText" Text="—" Style="{StaticResource ValueTextSmall}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
