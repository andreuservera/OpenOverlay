<UserControl x:Class="IRacingOverlay.App.Widgets.TrackInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IRacingOverlay.App.Localization"
             xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
             x:Name="Root"
             xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay">
    <!-- The fields are laid out by the code-behind, in the order and with the visibility the
         options give: a separator wherever neighbouring fields belong to different groups (track
         and session, conditions, timing), and a field's gap to the one before it otherwise. -->
    <UserControl.Resources>
        <!-- One line of readings (docs/widgets-style.md §7): each a muted caption in capitals then
             its value, every reading in its own cell with a 1px rule on its left, so the eye can
             jump straight to the one it wants. -->
        <Style x:Key="BarField" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BarCaption" TargetType="TextBlock" BasedOn="{StaticResource ColumnHeader}">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="BarValue" TargetType="TextBlock" BasedOn="{StaticResource DataCell}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>
        <Style x:Key="BarSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource Surface.Divider}"/>
        </Style>
        <Style x:Key="UsageSegment" TargetType="Rectangle">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Fill" Value="{StaticResource Surface.Track}"/>
        </Style>
    </UserControl.Resources>
    <!-- The cells carry their own padding. The header is off unless switched on: the bar is one line. -->
    <ov:WidgetFrame Title="{loc:T widget.TrackInfo.name}">
        <StackPanel x:Name="Bar" Orientation="Horizontal" HorizontalAlignment="Center">
            <!-- The circuit, after the live dot. Capped + trimmed: an unusually long circuit name
                 would otherwise push the session clock off the right-hand end. -->
            <StackPanel x:Name="FieldTrackName" Style="{StaticResource BarField}">
                <Control Template="{StaticResource LiveIndicator}" Margin="0,0,6,0" Focusable="False" IsTabStop="False"/>
                <TextBlock x:Name="TrackNameText" Text="—" Style="{StaticResource BarValue}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="SessionLabelText" Text="—" Style="{StaticResource BarValue}" Foreground="{StaticResource Text.Secondary}"/>

            <!-- The sky icon stays beside the air temperature: it is a reading in itself. -->
            <StackPanel x:Name="FieldAirTemp" Style="{StaticResource BarField}" ToolTip="{loc:T trackInfo.airTemperature}">
                <TextBlock Text="{loc:T trackInfo.airShort}" Style="{StaticResource BarCaption}"/>
                <w:WeatherIcon x:Name="SkyIcon" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,5,0"
                               SunBrush="{StaticResource State.Warning}" MoonBrush="{StaticResource Text.Primary}"
                               CloudBrush="{StaticResource Text.Secondary}" CloudShadeBrush="{StaticResource Text.Muted}"
                               RainBrush="{StaticResource State.Info}"/>
                <TextBlock x:Name="AirTempText" Text="—" Style="{StaticResource BarValue}"/>
            </StackPanel>

            <StackPanel x:Name="FieldTrackTemp" Style="{StaticResource BarField}" ToolTip="{loc:T trackInfo.trackTemperature}">
                <TextBlock Text="{loc:T trackInfo.trackShort}" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="TrackTempText" Text="—" Style="{StaticResource BarValue}"/>
            </StackPanel>

            <StackPanel x:Name="FieldWind" Style="{StaticResource BarField}" ToolTip="{loc:T trackInfo.wind}">
                <TextBlock Text="{loc:T trackInfo.windShort}" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="WindText" Text="—" Style="{StaticResource BarValue}"/>
            </StackPanel>

            <StackPanel x:Name="FieldHumidity" Style="{StaticResource BarField}" ToolTip="{loc:T trackInfo.relativeHumidity}">
                <TextBlock Text="{loc:T trackInfo.humidityShort}" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="HumidityText" Text="—" Style="{StaticResource BarValue}"/>
            </StackPanel>

            <StackPanel x:Name="FieldTrackUsage" Style="{StaticResource BarField}">
                <TextBlock Text="{loc:T trackInfo.usage}" Style="{StaticResource BarCaption}"/>
                <StackPanel x:Name="TrackUsageBar" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}"/>
                    <Rectangle Style="{StaticResource UsageSegment}" Margin="0"/>
                </StackPanel>
                <TextBlock x:Name="TrackUsageText" Text="—" Style="{StaticResource BarValue}"/>
            </StackPanel>

            <StackPanel x:Name="FieldTimeLeft" Style="{StaticResource BarField}">
                <TextBlock Text="{loc:T trackInfo.timeLeft}" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="TimeRemainingText" Text="—" Style="{StaticResource BarValue}"/>
            </StackPanel>

            <StackPanel x:Name="FieldLap" Style="{StaticResource BarField}">
                <TextBlock Text="{loc:T trackInfo.lap}" Style="{StaticResource BarCaption}"/>
                <TextBlock x:Name="LapText" Text="—" Style="{StaticResource BarValue}"/>
            </StackPanel>
        </StackPanel>
    </ov:WidgetFrame>
</UserControl>
