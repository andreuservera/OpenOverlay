<UserControl x:Class="IRacingOverlay.App.Widgets.TrackInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="14,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="TrackNameText" Text="—" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <TextBlock x:Name="SessionLabelText" Text="—" FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource Theme.LabelForeground}" VerticalAlignment="Center" Margin="10,2,0,0"/>

            <Rectangle Width="1" Fill="#3A3A3A" Margin="16,1"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="AIR" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="AirTempText" Text="—" FontSize="13" Foreground="#FFD24D" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="TRACK" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="TrackTempText" Text="—" FontSize="13" Foreground="#FFD24D" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="WIND" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="WindText" Text="—" FontSize="13" Foreground="#8FD3FF" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="HUMIDITY" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="HumidityText" Text="—" FontSize="13" Foreground="#8FD3FF" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="USAGE" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <StackPanel x:Name="TrackUsageBar" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Rectangle Width="5" Height="11" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="#2A2A2A"/>
                    <Rectangle Width="5" Height="11" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="#2A2A2A"/>
                    <Rectangle Width="5" Height="11" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="#2A2A2A"/>
                    <Rectangle Width="5" Height="11" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="#2A2A2A"/>
                    <Rectangle Width="5" Height="11" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="#2A2A2A"/>
                    <Rectangle Width="5" Height="11" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="#2A2A2A"/>
                    <Rectangle Width="5" Height="11" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="#2A2A2A"/>
                    <Rectangle Width="5" Height="11" RadiusX="1" RadiusY="1" Fill="#2A2A2A"/>
                </StackPanel>
                <TextBlock x:Name="TrackUsageText" Text="—" FontSize="13" Foreground="#C8A2FF" VerticalAlignment="Center"/>
            </StackPanel>

            <Rectangle Width="1" Fill="#3A3A3A" Margin="0,1,16,1"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="TIME LEFT" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="TimeRemainingText" Text="—" FontSize="13" FontWeight="Bold" Foreground="White" FontFamily="Consolas" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LAPS LEFT" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="LapsRemainingText" Text="—" FontSize="13" FontWeight="Bold" Foreground="White" FontFamily="Consolas" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
