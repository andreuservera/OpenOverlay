<UserControl x:Class="IRacingOverlay.App.Widgets.ShiftGearPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Angled accent brackets flanking the gear digit, matching the reference design —
                 not a real control, just two static polylines, so no code-behind needed for these. -->
            <Polyline Grid.Column="0" Points="14,0 3,28 14,56" Stroke="{StaticResource State.Warning}" StrokeThickness="3"
                      VerticalAlignment="Center" Margin="0,0,8,0"/>

            <!-- 56 is a proportion, not a size: the whole CockpitPanel this sits in is laid out once
                 at its 310x150 design canvas and then scaled as a unit by ScalablePanel's
                 LayoutTransform, so this only fixes how big the gear digit is *relative to*
                 Speed/RPM in the same cluster. It scales with them at every level, so it can never
                 overflow or overlap them no matter which size the user picks. -->
            <TextBlock x:Name="GearText" Grid.Column="1" Text="–" FontSize="56" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"
                       HorizontalAlignment="Center" FontFamily="{DynamicResource Theme.GearFontFamily}"/>

            <Polyline Grid.Column="2" Points="3,0 14,28 3,56" Stroke="{StaticResource State.Warning}" StrokeThickness="3"
                      VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>
        <TextBlock Text="GEAR" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
