<UserControl x:Class="IRacingOverlay.App.Widgets.ShiftGearPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The gear sits on its own raised tile: the centrepiece of the cluster, framed by surface rather
         than by ornament. Its edge turns red at the shift point (see SetShiftPoint). -->
    <Border x:Name="Tile" Width="76" CornerRadius="8" BorderThickness="1" Padding="0,8"
            Background="{StaticResource Row.Base}" BorderBrush="{StaticResource Surface.ChipBorder}"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <!-- Type.Gear is a proportion, not a size: the whole CockpitPanel this sits in is laid out
                 once at its 310x150 design canvas and then scaled as a unit by ScalablePanel's
                 LayoutTransform, so this only fixes how big the gear digit is *relative to*
                 Speed/RPM in the same cluster. -->
            <TextBlock x:Name="GearText" Text="–" FontSize="{StaticResource Type.Gear}" FontWeight="Bold"
                       LineHeight="{StaticResource Line.Gear}" LineStackingStrategy="BlockLineHeight"
                       Foreground="{StaticResource Text.Primary}"
                       HorizontalAlignment="Center" FontFamily="{DynamicResource Theme.GearFontFamily}"/>
            <TextBlock Text="GEAR" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
