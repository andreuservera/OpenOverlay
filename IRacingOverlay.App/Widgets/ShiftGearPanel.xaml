<UserControl x:Class="IRacingOverlay.App.Widgets.ShiftGearPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Frame, not signal: the brackets set the gear apart as the centrepiece, in neutral ink so
             the shift lights above stay the only thing on the cluster that changes colour. -->
        <Style x:Key="GearBracket" TargetType="Polyline">
            <Setter Property="Stroke" Value="{StaticResource Text.Muted}"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="StrokeThickness" Value="2.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Angled brackets flanking the gear digit — not a real control, just two static
                 polylines, so no code-behind needed for these. -->
            <Polyline Grid.Column="0" Points="14,0 3,28 14,56" Style="{StaticResource GearBracket}" Margin="0,0,8,0"/>

            <!-- Type.Gear is a proportion, not a size: the whole CockpitPanel this sits in is laid out
                 once at its 310x150 design canvas and then scaled as a unit by ScalablePanel's
                 LayoutTransform, so this only fixes how big the gear digit is *relative to*
                 Speed/RPM in the same cluster. Its line box stays on the grid, so a bigger digit
                 never makes the cluster taller. -->
            <TextBlock x:Name="GearText" Grid.Column="1" Text="–" FontSize="{StaticResource Type.Gear}" FontWeight="Bold"
                       LineHeight="{StaticResource Line.Gear}" LineStackingStrategy="BlockLineHeight"
                       Foreground="{StaticResource Text.Primary}"
                       HorizontalAlignment="Center" FontFamily="{DynamicResource Theme.GearFontFamily}"/>

            <Polyline Grid.Column="2" Points="3,0 14,28 3,56" Style="{StaticResource GearBracket}" Margin="8,0,0,0"/>
        </Grid>
        <TextBlock Text="GEAR" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
