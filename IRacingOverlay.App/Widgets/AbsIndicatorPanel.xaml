<UserControl x:Class="IRacingOverlay.App.Widgets.AbsIndicatorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same tinted, outlined badge as the PIT and licence chips: neutral while idle, amber while
         ABS is working. -->
    <Border x:Name="Light" Width="56" Height="20" CornerRadius="{StaticResource Radius.Chip}" BorderThickness="1"
            Background="{StaticResource Surface.Chip}" BorderBrush="{StaticResource Surface.ChipBorder}">
        <TextBlock x:Name="Label" Text="ABS" Style="{StaticResource StatusBadgeText}"
                   Foreground="{StaticResource Text.Muted}" HorizontalAlignment="Center"/>
    </Border>
</UserControl>
