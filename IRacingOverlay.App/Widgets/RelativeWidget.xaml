<ov:OverlayWindowBase x:Class="IRacingOverlay.App.Widgets.RelativeWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
        xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
        Title="Relative">
    <Border BorderBrush="Orange" BorderThickness="0">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <!-- Driver names are the widest thing here and the name column is a star, so left to measure
             itself the panel collapses to whatever names happen to be on track right now. 300 keeps
             the row rhythm steady and gives full names room instead of ellipsing them. -->
        <ov:ScalablePanel x:Name="Scaler" ShowButtons="{Binding IsEditMode}" PersistenceKey="Widget.Relative"
                          DesignWidth="300">
            <w:RelativePanel/>
        </ov:ScalablePanel>
    </Border>
</ov:OverlayWindowBase>
