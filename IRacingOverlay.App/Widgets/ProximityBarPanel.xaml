<UserControl x:Class="IRacingOverlay.App.Widgets.ProximityBarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Segments are added in code-behind, one per SegmentCount, so the count only needs to change
         in one place. Row 0 is the TOP (our front bumper), last row is the BOTTOM (our rear
         bumper) — matching ProximitySide's BandStart=0/BandEnd=1 convention. -->
    <Grid x:Name="Track" Background="#141210"/>
</UserControl>
