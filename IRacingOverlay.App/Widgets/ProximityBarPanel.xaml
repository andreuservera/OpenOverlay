<UserControl x:Class="IRacingOverlay.App.Widgets.ProximityBarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Track" Background="#221E1A" CornerRadius="4">
        <Grid VerticalAlignment="Stretch">
            <Rectangle x:Name="Fill" Fill="#FFB000" VerticalAlignment="Bottom" Height="0"/>
        </Grid>
    </Border>
</UserControl>
