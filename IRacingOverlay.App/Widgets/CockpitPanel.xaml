<UserControl x:Class="IRacingOverlay.App.Widgets.CockpitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
             x:Name="Root">
    <!-- Chrome (background/border/corners) follows the active Dashboard theme like every other
         panel — only the semantic colors (shift-light dots, amber proximity bars, gear brackets,
         ABS glow) stay hardcoded, since those must match their real-world meaning regardless of
         theme, the same principle FlagPanel already uses for flag colors. -->
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="8,6">
        <Grid>
            <!-- The three center columns are fixed pixel widths sized tightly to their actual
                 content (not star-ratios, which stretch to fill however much space the design
                 canvas declares whether or not the digits need it — that's what was leaving visible
                 dead air between speed/gear/RPM). These specific numbers were derived from measuring
                 this panel's own natural (Auto-sized) width in isolation, NOT re-declared as Auto
                 here — Auto columns measured correctly standalone but badly miscomputed (a large,
                 wrong blowup) once nested under the Dashboard's LayoutTransform-based +/- zoom, a
                 known-troublesome WPF combination (LayoutTransform + Auto/content-driven sizing can
                 mis-iterate). Fixed pixel widths give the exact same tight fit without that risk. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Proximity bars run the full height of the panel, flanking everything else. -->
            <w:ProximityBarPanel x:Name="LeftProximity" Grid.Column="0" Grid.RowSpan="2" Margin="0,2"/>
            <w:ProximityBarPanel x:Name="RightProximity" Grid.Column="4" Grid.RowSpan="2" Margin="0,2"/>

            <!-- Shift lights span the speed/gear/RPM columns, not just the gear digit. -->
            <w:ShiftLightsPanel x:Name="ShiftLights" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6"/>

            <!-- Speed and RPM share one layout — value, hairline rule, unit — so the eye learns a
                 single pattern and the two units line up horizontally instead of one label sitting
                 above its number and the other below. -->
            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="SpeedText" Text="—" Style="{StaticResource DisplayValue}"
                           FontSize="{StaticResource Type.DisplayLarge}" HorizontalAlignment="Center"/>
                <Border Background="{StaticResource Surface.Divider}" Height="1" Margin="4,3,4,4"/>
                <TextBlock Text="KM/H" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
            </StackPanel>

            <w:ShiftGearPanel x:Name="ShiftGear" Grid.Row="1" Grid.Column="2"/>

            <StackPanel Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="RpmText" Text="—" Style="{StaticResource DisplayValue}"
                           FontSize="{StaticResource Type.DisplaySmall}" HorizontalAlignment="Center"/>
                <Border Background="{StaticResource Surface.Divider}" Height="1" Margin="4,3,4,4"/>
                <TextBlock Text="RPM" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <w:AbsIndicatorPanel x:Name="AbsIndicator" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
