<UserControl x:Class="IRacingOverlay.App.Widgets.CockpitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
             x:Name="Root">
    <Border Background="#E6141414" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>

            <w:ProximityBarPanel x:Name="LeftProximity" Grid.Column="0" Margin="2,0"/>
            <w:ShiftGearPanel x:Name="ShiftGear" Grid.Column="1"/>
            <w:GlowBarPanel x:Name="AbsBar" Grid.Column="2" Margin="2,0"/>
            <w:ProximityBarPanel x:Name="RightProximity" Grid.Column="3" Margin="2,0"/>
        </Grid>
    </Border>
</UserControl>
