<UserControl x:Class="IRacingOverlay.App.Widgets.TireInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IRacingOverlay.App.ViewModels"
             x:Name="Root">
    <UserControl.Resources>
        <!-- One corner: label, pressure, then the tread in three zones (left, centre, right) — the
             carcass temperature over the remaining wear, with a bar per zone. The four corners are
             the same template. Type sits on the same steps as the other widgets: captions at label
             size, readings at body size, pressure a value step up. -->
        <Style x:Key="CornerLabel" TargetType="TextBlock" BasedOn="{StaticResource PanelTitle}">
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="ZoneHeader" TargetType="TextBlock" BasedOn="{StaticResource ColumnHeader}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ZoneTemp" TargetType="TextBlock" BasedOn="{StaticResource DataCell}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ZoneWear" TargetType="TextBlock" BasedOn="{StaticResource DataCell}">
            <Setter Property="FontFamily" Value="{DynamicResource Theme.NumericFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ZoneTrack" TargetType="Border" BasedOn="{StaticResource MeterTrack}">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Margin" Value="0,3,6,0"/>
        </Style>
        <Style x:Key="ZoneFill" TargetType="Rectangle">
            <Setter Property="RadiusX" Value="2"/>
            <Setter Property="RadiusY" Value="2"/>
            <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
        </Style>

        <DataTemplate x:Key="CornerTemplate" DataType="{x:Type vm:TireCornerInfo}">
            <StackPanel>
                <TextBlock Text="{Binding Label, Mode=OneTime}" Style="{StaticResource CornerLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PressureDisplay, Mode=OneTime}" Style="{StaticResource ValueTextLarge}"/>
                    <TextBlock Text="{Binding PressureUnit, Mode=OneTime}" Style="{StaticResource UnitLabel}" VerticalAlignment="Bottom"
                               Margin="4,0,0,3" Visibility="{Binding HasPressure, Mode=OneTime, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="L" Style="{StaticResource ZoneHeader}"/>
                    <TextBlock Grid.Column="1" Text="C" Style="{StaticResource ZoneHeader}"/>
                    <TextBlock Grid.Column="2" Text="R" Style="{StaticResource ZoneHeader}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TempLeftDisplay, Mode=OneTime}" Style="{StaticResource ZoneTemp}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TempMiddleDisplay, Mode=OneTime}" Style="{StaticResource ZoneTemp}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TempRightDisplay, Mode=OneTime}" Style="{StaticResource ZoneTemp}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding WearLeftDisplay, Mode=OneTime}" Foreground="{Binding WearLeftColor, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}" Style="{StaticResource ZoneWear}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WearMiddleDisplay, Mode=OneTime}" Foreground="{Binding WearMiddleColor, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}" Style="{StaticResource ZoneWear}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding WearRightDisplay, Mode=OneTime}" Foreground="{Binding WearRightColor, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}" Style="{StaticResource ZoneWear}"/>

                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource ZoneTrack}">
                        <Rectangle Fill="{Binding WearLeftColor, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}" Style="{StaticResource ZoneFill}">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{Binding WearLeftFill, Mode=OneTime}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource ZoneTrack}">
                        <Rectangle Fill="{Binding WearMiddleColor, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}" Style="{StaticResource ZoneFill}">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{Binding WearMiddleFill, Mode=OneTime}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource ZoneTrack}">
                        <Rectangle Fill="{Binding WearRightColor, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}" Style="{StaticResource ZoneFill}">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{Binding WearRightFill, Mode=OneTime}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Border>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{StaticResource OverlayPanel}" Padding="12,9">
        <StackPanel>
            <TextBlock Text="TIRES" Style="{StaticResource PanelTitle}" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ContentControl x:Name="LFCorner" Grid.Row="0" Grid.Column="0" Margin="2,3,12,6" ContentTemplate="{StaticResource CornerTemplate}" Focusable="False"/>
                <ContentControl x:Name="RFCorner" Grid.Row="0" Grid.Column="1" Margin="6,3,2,6" ContentTemplate="{StaticResource CornerTemplate}" Focusable="False"/>
                <ContentControl x:Name="LRCorner" Grid.Row="1" Grid.Column="0" Margin="2,3,12,3" ContentTemplate="{StaticResource CornerTemplate}" Focusable="False"/>
                <ContentControl x:Name="RRCorner" Grid.Row="1" Grid.Column="1" Margin="6,3,2,3" ContentTemplate="{StaticResource CornerTemplate}" Focusable="False"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
