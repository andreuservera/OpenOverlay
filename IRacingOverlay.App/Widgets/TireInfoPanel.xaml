<UserControl x:Class="IRacingOverlay.App.Widgets.TireInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="8">
        <StackPanel>
            <TextBlock Text="TIRES" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                    <TextBlock Text="LF" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="LFPressureText" Text="—" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LFTempLeftText" Text="—" Foreground="#FFD24D" FontSize="11" Width="28"/>
                        <TextBlock x:Name="LFTempMiddleText" Text="—" Foreground="#FFD24D" FontSize="11" Width="28"/>
                        <TextBlock x:Name="LFTempRightText" Text="—" Foreground="#FFD24D" FontSize="11" Width="28"/>
                    </StackPanel>
                    <Border x:Name="LFWearTrack" Background="#2A2A2A" CornerRadius="2" Height="5" Margin="0,3,0,0">
                        <Rectangle x:Name="LFWearFill" Fill="#3DDC7A" HorizontalAlignment="Left" Width="0"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                    <TextBlock Text="RF" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="RFPressureText" Text="—" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RFTempLeftText" Text="—" Foreground="#FFD24D" FontSize="11" Width="28"/>
                        <TextBlock x:Name="RFTempMiddleText" Text="—" Foreground="#FFD24D" FontSize="11" Width="28"/>
                        <TextBlock x:Name="RFTempRightText" Text="—" Foreground="#FFD24D" FontSize="11" Width="28"/>
                    </StackPanel>
                    <Border x:Name="RFWearTrack" Background="#2A2A2A" CornerRadius="2" Height="5" Margin="0,3,0,0">
                        <Rectangle x:Name="RFWearFill" Fill="#3DDC7A" HorizontalAlignment="Left" Width="0"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                    <TextBlock Text="LR" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="LRPressureText" Text="—" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LRTempLeftText" Text="—" Foreground="#FFD24D" FontSize="11" Width="28"/>
                        <TextBlock x:Name="LRTempMiddleText" Text="—" Foreground="#FFD24D" FontSize="11" Width="28"/>
                        <TextBlock x:Name="LRTempRightText" Text="—" Foreground="#FFD24D" FontSize="11" Width="28"/>
                    </StackPanel>
                    <Border x:Name="LRWearTrack" Background="#2A2A2A" CornerRadius="2" Height="5" Margin="0,3,0,0">
                        <Rectangle x:Name="LRWearFill" Fill="#3DDC7A" HorizontalAlignment="Left" Width="0"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                    <TextBlock Text="RR" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="RRPressureText" Text="—" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RRTempLeftText" Text="—" Foreground="#FFD24D" FontSize="11" Width="28"/>
                        <TextBlock x:Name="RRTempMiddleText" Text="—" Foreground="#FFD24D" FontSize="11" Width="28"/>
                        <TextBlock x:Name="RRTempRightText" Text="—" Foreground="#FFD24D" FontSize="11" Width="28"/>
                    </StackPanel>
                    <Border x:Name="RRWearTrack" Background="#2A2A2A" CornerRadius="2" Height="5" Margin="0,3,0,0">
                        <Rectangle x:Name="RRWearFill" Fill="#3DDC7A" HorizontalAlignment="Left" Width="0"/>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
