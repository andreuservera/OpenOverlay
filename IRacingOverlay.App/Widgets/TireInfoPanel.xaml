<UserControl x:Class="IRacingOverlay.App.Widgets.TireInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Corner block: label, pressure, the three carcass temps, wear bar. Four identical
             sub-layouts, so the shared pieces live here instead of being retyped per corner. -->
        <Style x:Key="CornerLabel" TargetType="TextBlock" BasedOn="{StaticResource ColumnHeader}">
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="CornerTemp" TargetType="TextBlock" BasedOn="{StaticResource DataCellNumeric}">
            <Setter Property="Foreground" Value="{StaticResource State.Accent}"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Micro}"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="10,8">
        <StackPanel>
            <TextBlock Text="TIRES" Style="{StaticResource PanelTitle}" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="2,3,8,3">
                    <TextBlock Text="LF" Style="{StaticResource CornerLabel}"/>
                    <TextBlock x:Name="LFPressureText" Text="—" Style="{StaticResource ValueText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <TextBlock x:Name="LFTempLeftText" Text="—" Style="{StaticResource CornerTemp}"/>
                        <TextBlock x:Name="LFTempMiddleText" Text="—" Style="{StaticResource CornerTemp}"/>
                        <TextBlock x:Name="LFTempRightText" Text="—" Style="{StaticResource CornerTemp}"/>
                    </StackPanel>
                    <Border x:Name="LFWearTrack" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}"
                            Height="6" Margin="0,4,0,0">
                        <Rectangle x:Name="LFWearFill" Fill="{StaticResource State.Positive}" HorizontalAlignment="Left" Width="0"
                                   RadiusX="3" RadiusY="3"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,3,2,3">
                    <TextBlock Text="RF" Style="{StaticResource CornerLabel}"/>
                    <TextBlock x:Name="RFPressureText" Text="—" Style="{StaticResource ValueText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <TextBlock x:Name="RFTempLeftText" Text="—" Style="{StaticResource CornerTemp}"/>
                        <TextBlock x:Name="RFTempMiddleText" Text="—" Style="{StaticResource CornerTemp}"/>
                        <TextBlock x:Name="RFTempRightText" Text="—" Style="{StaticResource CornerTemp}"/>
                    </StackPanel>
                    <Border x:Name="RFWearTrack" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}"
                            Height="6" Margin="0,4,0,0">
                        <Rectangle x:Name="RFWearFill" Fill="{StaticResource State.Positive}" HorizontalAlignment="Left" Width="0"
                                   RadiusX="3" RadiusY="3"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="2,3,8,3">
                    <TextBlock Text="LR" Style="{StaticResource CornerLabel}"/>
                    <TextBlock x:Name="LRPressureText" Text="—" Style="{StaticResource ValueText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <TextBlock x:Name="LRTempLeftText" Text="—" Style="{StaticResource CornerTemp}"/>
                        <TextBlock x:Name="LRTempMiddleText" Text="—" Style="{StaticResource CornerTemp}"/>
                        <TextBlock x:Name="LRTempRightText" Text="—" Style="{StaticResource CornerTemp}"/>
                    </StackPanel>
                    <Border x:Name="LRWearTrack" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}"
                            Height="6" Margin="0,4,0,0">
                        <Rectangle x:Name="LRWearFill" Fill="{StaticResource State.Positive}" HorizontalAlignment="Left" Width="0"
                                   RadiusX="3" RadiusY="3"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,3,2,3">
                    <TextBlock Text="RR" Style="{StaticResource CornerLabel}"/>
                    <TextBlock x:Name="RRPressureText" Text="—" Style="{StaticResource ValueText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <TextBlock x:Name="RRTempLeftText" Text="—" Style="{StaticResource CornerTemp}"/>
                        <TextBlock x:Name="RRTempMiddleText" Text="—" Style="{StaticResource CornerTemp}"/>
                        <TextBlock x:Name="RRTempRightText" Text="—" Style="{StaticResource CornerTemp}"/>
                    </StackPanel>
                    <Border x:Name="RRWearTrack" Background="{StaticResource Surface.Track}" CornerRadius="{StaticResource Radius.Chip}"
                            Height="6" Margin="0,4,0,0">
                        <Rectangle x:Name="RRWearFill" Fill="{StaticResource State.Positive}" HorizontalAlignment="Left" Width="0"
                                   RadiusX="3" RadiusY="3"/>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
