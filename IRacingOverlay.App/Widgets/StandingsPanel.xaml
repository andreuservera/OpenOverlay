<UserControl x:Class="IRacingOverlay.App.Widgets.StandingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IRacingOverlay.App.ViewModels"
             xmlns:conv="clr-namespace:IRacingOverlay.App.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:ColumnVisibilityConverter x:Key="ColumnVisibilityConverter"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="6">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="STANDINGS" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="SofText" Text="" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="11"
                           FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
            <Grid DockPanel.Dock="Top" Margin="2,0,2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowIRating, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=50}"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowIRatingDelta, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=44}"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowLicense, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=40}"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=34}"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowLastLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=72}"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowBestLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=72}"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowGap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=60}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="POS" Foreground="#666666" FontSize="10" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="DRIVER" Foreground="#666666" FontSize="10" FontWeight="Bold" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="3" Text="iR" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowIRating, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="4" Text="iRΔ" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowIRatingDelta, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="5" Text="SR" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowLicense, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="6" Text="LAP" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="7" Text="LAST" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowLastLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="8" Text="BEST" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowBestLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="9" Text="GAP" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowGap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
            </Grid>
            <Grid>
                <TextBlock Text="Waiting for iRacing telemetry…" Foreground="#777777" FontSize="12"
                           FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count, ElementName=Root}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows, ElementName=Root}">
                        <ItemsControl.Resources>
                            <!-- No explicit ItemTemplate on the ItemsControl itself — WPF picks
                                 whichever of these matches each item's runtime type, so a plain
                                 mixed list of StandingsRow/StandingsHeaderRow renders correctly. -->
                            <DataTemplate DataType="{x:Type vm:StandingsHeaderRow}">
                                <Border Background="{Binding HeaderBackground}" Margin="0,6,0,2" Padding="4,2" CornerRadius="2">
                                    <TextBlock Text="{Binding ClassName}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:StandingsRow}">
                                <Border Background="{Binding RowBackground}" Margin="0,1" Padding="2,1" CornerRadius="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowIRating, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=50}"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowIRatingDelta, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=44}"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowLicense, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=40}"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=34}"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowLastLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=72}"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowBestLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=72}"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowGap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=60}"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PositionDisplay}" Foreground="#AAAAAA" FontSize="12"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{Binding ClassColor}" CornerRadius="2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding CarNumber}" Foreground="Black" FontWeight="Bold"
                                                       HorizontalAlignment="Center" FontSize="12"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="White" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding IRatingDisplay}" Foreground="#9FE0A0" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding ColumnVisibility.ShowIRating, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding IRatingDeltaDisplay}" Foreground="{Binding IRatingDeltaForeground}" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding ColumnVisibility.ShowIRatingDelta, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                                        <Border Grid.Column="5" Background="{Binding LicenseColor}" CornerRadius="2" Margin="4,1"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding ColumnVisibility.ShowLicense, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}">
                                            <TextBlock Text="{Binding LicStringDisplay}" Foreground="White" FontWeight="Bold"
                                                       FontSize="10" Padding="3,1" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="6" Text="{Binding CurrentLap}" Foreground="#CCCCCC" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding ColumnVisibility.ShowLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="7" Text="{Binding LastLapDisplay}" Foreground="#CCCCCC" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding ColumnVisibility.ShowLastLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="8" Text="{Binding BestLapDisplay}" Foreground="{Binding BestLapForeground}"
                                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding ColumnVisibility.ShowBestLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="9" Text="{Binding GapDisplay}" Foreground="#FFD24D" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding ColumnVisibility.ShowGap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
