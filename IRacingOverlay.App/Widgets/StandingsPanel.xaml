<UserControl x:Class="IRacingOverlay.App.Widgets.StandingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IRacingOverlay.App.ViewModels"
             x:Name="Root">
    <Border Background="#E6141414" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="6">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="STANDINGS" Foreground="#888888" FontSize="11"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <Grid DockPanel.Dock="Top" Margin="2,0,2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="POS" Foreground="#666666" FontSize="10" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="DRIVER" Foreground="#666666" FontSize="10" FontWeight="Bold" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="3" Text="LAP" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="LAST" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="BEST" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="6" Text="GAP" Foreground="#666666" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
            <Grid>
                <TextBlock Text="Waiting for iRacing telemetry…" Foreground="#777777" FontSize="12"
                           FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count, ElementName=Root}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows, ElementName=Root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StandingsRow}">
                                <Border Background="{Binding RowBackground}" Margin="0,1" Padding="2,1" CornerRadius="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PositionDisplay}" Foreground="#AAAAAA" FontSize="12"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{Binding ClassColor}" CornerRadius="2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding CarNumber}" Foreground="Black" FontWeight="Bold"
                                                       HorizontalAlignment="Center" FontSize="12"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="White" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CurrentLap}" Foreground="#CCCCCC" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding LastLapDisplay}" Foreground="#CCCCCC" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding BestLapDisplay}" Foreground="#8FD3FF" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding GapDisplay}" Foreground="#FFD24D" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
