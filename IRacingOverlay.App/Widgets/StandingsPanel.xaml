<UserControl x:Class="IRacingOverlay.App.Widgets.StandingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IRacingOverlay.App.ViewModels"
             x:Name="Root">
    <!-- Columns, cell styles and the row template all come from Themes/DriverTable.xaml, merged
         application-wide and shared with RelativePanel. -->
    <Border Style="{StaticResource OverlayPanel}" Padding="10,8">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="STANDINGS" Style="{StaticResource PanelTitle}"/>
                    <!-- The category the player races in (e.g. GT3). Trimmed rather than allowed to
                         push the header wider than the table beneath it. -->
                    <TextBlock x:Name="ClassNameText" Text="" Style="{StaticResource ColumnHeader}"
                               Margin="9,0,12,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Session id and SOF describe the whole lobby, so they belong in the header
                         once rather than as a column repeating itself on every row. -->
                    <TextBlock x:Name="SessionIdText" Text="" Style="{StaticResource ColumnHeader}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="SofText" Text="" Style="{StaticResource ColumnHeader}"/>
                </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Top" Margin="{StaticResource RulerInset}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Options.ShowPosition, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.Pos}}"/>
                    <ColumnDefinition Width="{Binding Options.ShowCarNumber, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.Car}}"/>
                    <ColumnDefinition Width="{Binding Options.ShowDriver, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.Driver}}"/>
                    <ColumnDefinition Width="{Binding Options.ShowLastPitStop, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.LastPit}}"/>
                    <ColumnDefinition Width="{Binding Options.ShowTireCompound, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.Tire}}"/>
                    <ColumnDefinition Width="{Binding Options.ShowIRating, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.IRating}}"/>
                    <ColumnDefinition Width="{Binding Options.ShowIRatingDelta, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.IRatingDelta}}"/>
                    <ColumnDefinition Width="{Binding Options.ShowLicense, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.License}}"/>
                    <ColumnDefinition Width="{Binding Options.ShowLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.Lap}}"/>
                    <ColumnDefinition Width="{Binding Options.ShowBestLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.BestLap}}"/>
                    <ColumnDefinition Width="{Binding Options.ShowLastLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.LastLap}}"/>
                    <ColumnDefinition Width="{Binding Options.ShowGap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.Gap}}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="POS" Style="{StaticResource HeadNumeric}"
                           Visibility="{Binding Options.ShowPosition, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="1" Text="CAR" Style="{StaticResource HeadCentered}"
                           Visibility="{Binding Options.ShowCarNumber, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="2" Text="DRIVER" Style="{StaticResource HeadText}"
                           Visibility="{Binding Options.ShowDriver, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="3" Text="LAST PIT" Style="{StaticResource HeadCentered}"
                           Visibility="{Binding Options.ShowLastPitStop, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="4" Text="TIRE" Style="{StaticResource HeadCentered}"
                           Visibility="{Binding Options.ShowTireCompound, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="5" Grid.ColumnSpan="2" Text="iR" Style="{StaticResource HeadCentered}"
                           Visibility="{Binding Options.ShowIRating, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="7" Text="SR" Style="{StaticResource HeadCentered}"
                           Visibility="{Binding Options.ShowLicense, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="8" Text="LAP" Style="{StaticResource HeadNumeric}"
                           Visibility="{Binding Options.ShowLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="9" Text="BEST" Style="{StaticResource HeadNumeric}"
                           Visibility="{Binding Options.ShowBestLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="10" Text="LAST" Style="{StaticResource HeadNumeric}"
                           Visibility="{Binding Options.ShowLastLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="11" Text="GAP" Style="{StaticResource HeadNumeric}"
                           Visibility="{Binding Options.ShowGap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
            </Grid>

            <!-- Hairline under the ruler: separates "what the columns are" from "what the data is"
                 without spending as much vertical space as a gap big enough to do the same job. -->
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Surface.DividerFade}" Margin="0,0,0,4"/>

            <!-- Session progress: one value each for the whole field, so a footer rather than a
                 column — the player's lap out of the race's laps (estimated from their pace in a
                 timed race) and the clock. Docked before the rows so it never scrolls with them. -->
            <Grid DockPanel.Dock="Bottom" Margin="0,5,0,0"
                  Visibility="{Binding Options.ShowFooter, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Border Height="1" VerticalAlignment="Top" Background="{StaticResource Surface.DividerFade}"/>
                <Grid Margin="8,6,4,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,18,0"
                                Visibility="{Binding Options.ShowSessionLaps, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="LAP" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SessionLapsText" Text="—" Style="{StaticResource DataCell}"
                                   FontFamily="{DynamicResource Theme.NumericFontFamily}" Foreground="{StaticResource Text.Primary}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding Options.ShowSessionTime, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="TIME" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SessionTimeText" Text="—" Style="{StaticResource DataCell}"
                                   FontFamily="{DynamicResource Theme.NumericFontFamily}" Foreground="{StaticResource Text.Primary}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid>
                <TextBlock Text="Waiting for iRacing telemetry…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count, ElementName=Root}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- No ScrollViewer: the widget sizes itself to its rows, and StandingsBuilder caps
                     how many there are, so there is never anything to scroll to — but there is also
                     never anything cut off. -->
                <ItemsControl ItemsSource="{Binding Rows, ElementName=Root}">
                    <ItemsControl.Resources>
                        <!-- Class title bar: the same bar-and-wash as the rows beneath it, at a
                             stronger strength, so a class reads as one block from its title down.
                             Stretches rather than sizing to its text, so it can never be what
                             decides the widget's width. -->
                        <DataTemplate DataType="{x:Type vm:StandingsHeaderRow}">
                            <Grid Height="17" Margin="0,6,0,2">
                                <Border CornerRadius="{StaticResource Radius.Chip}"
                                        Background="{Binding ClassColor, Converter={StaticResource ClassGradientConverter}, ConverterParameter=0.55}"/>
                                <Border Width="3" HorizontalAlignment="Left" Background="{Binding ClassColor}"
                                        CornerRadius="3,0,0,3"/>
                                <TextBlock Text="{Binding ClassName}" Style="{StaticResource PanelTitle}"
                                           Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>

                        <!-- The break between the podium and the block around the player: a rule
                             that feathers out at both ends, with the number of cars in the gap
                             sitting in it when there are any. Fixed height either way, so the widget
                             doesn't twitch as cars move in and out of the gap. -->
                        <DataTemplate DataType="{x:Type vm:StandingsSeparatorRow}">
                            <Grid Height="14" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="1" Background="{StaticResource Surface.DividerFadeIn}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource ColumnHeader}" Margin="8,0"
                                           Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVis}}"/>
                                <Border Grid.Column="2" Height="1" Background="{StaticResource Surface.DividerFadeOut}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.Resources>
                    <ItemsControl.ItemTemplate>
                        <!-- Rows sit in fixed RowSlots; the implicit per-DataType templates pick the
                             visual for whatever row the slot holds this tick. -->
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Value}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
