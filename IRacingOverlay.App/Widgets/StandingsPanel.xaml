<UserControl x:Class="IRacingOverlay.App.Widgets.StandingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IRacingOverlay.App.ViewModels"
             xmlns:conv="clr-namespace:IRacingOverlay.App.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:ColumnVisibilityConverter x:Key="ColumnVisibilityConverter"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="10,8">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="STANDINGS" Style="{StaticResource PanelTitle}"/>
                <TextBlock x:Name="SofText" Text="" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"/>
            </Grid>
            <!-- Header cells and row cells share one column ruler: this Grid's left margin matches
                 each row Border's left padding, so "BEST" sits exactly over the lap times beneath
                 it instead of drifting a few pixels out of column. -->
            <Grid DockPanel.Dock="Top" Margin="5,0,5,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowIRating, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=48}"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowIRatingDelta, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=44}"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowLicense, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=40}"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=32}"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowLastLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=68}"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowBestLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=68}"/>
                    <ColumnDefinition Width="{Binding ColumnVisibility.ShowGap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=58}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="POS" Style="{StaticResource ColumnHeader}"/>
                <TextBlock Grid.Column="2" Text="DRIVER" Style="{StaticResource ColumnHeader}" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="3" Text="iR" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowIRating, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="4" Text="iRΔ" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowIRatingDelta, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="5" Text="SR" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowLicense, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="6" Text="LAP" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="7" Text="LAST" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowLastLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="8" Text="BEST" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowBestLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="9" Text="GAP" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"
                           Visibility="{Binding ColumnVisibility.ShowGap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
            </Grid>
            <!-- Hairline under the ruler: separates "what the columns are" from "what the data is"
                 without spending as much vertical space as a gap big enough to do the same job. -->
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Surface.Divider}" Margin="0,0,0,4"/>
            <Grid>
                <TextBlock Text="Waiting for iRacing telemetry…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count, ElementName=Root}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows, ElementName=Root}">
                        <ItemsControl.Resources>
                            <!-- No explicit ItemTemplate on the ItemsControl itself — WPF picks
                                 whichever of these matches each item's runtime type, so a plain
                                 mixed list of StandingsRow/StandingsHeaderRow renders correctly. -->
                            <DataTemplate DataType="{x:Type vm:StandingsHeaderRow}">
                                <Border Background="{Binding HeaderBackground}" Margin="0,8,0,3" Padding="6,3"
                                        CornerRadius="{StaticResource Radius.Chip}">
                                    <TextBlock Text="{Binding ClassName}" Foreground="{StaticResource Text.Primary}"
                                               FontSize="{StaticResource Type.Label}" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:StandingsRow}">
                                <Border Background="{Binding RowBackground}" Margin="0,1" Padding="5,2"
                                        CornerRadius="{StaticResource Radius.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="132"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowIRating, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=48}"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowIRatingDelta, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=44}"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowLicense, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=40}"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=32}"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowLastLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=68}"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowBestLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=68}"/>
                                            <ColumnDefinition Width="{Binding ColumnVisibility.ShowGap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=58}"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PositionDisplay}" Style="{StaticResource DataCellNumeric}"
                                                   Foreground="{StaticResource Text.Primary}" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="1" Background="{Binding ClassColor}" CornerRadius="{StaticResource Radius.Chip}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding CarNumber}" Foreground="{StaticResource Text.OnAccent}" FontWeight="Bold"
                                                       HorizontalAlignment="Center" FontSize="{StaticResource Type.Body}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource DataCell}"
                                                   Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding IRatingDisplay}" Style="{StaticResource DataCellNumeric}"
                                                   Visibility="{Binding ColumnVisibility.ShowIRating, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding IRatingDeltaDisplay}" Style="{StaticResource DataCellNumeric}"
                                                   Foreground="{Binding IRatingDeltaForeground}"
                                                   Visibility="{Binding ColumnVisibility.ShowIRatingDelta, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                                        <Border Grid.Column="5" Background="{Binding LicenseColor}" CornerRadius="{StaticResource Radius.Chip}" Margin="4,1"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding ColumnVisibility.ShowLicense, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}">
                                            <TextBlock Text="{Binding LicStringDisplay}" Foreground="{StaticResource Text.Primary}" FontWeight="Bold"
                                                       FontSize="{StaticResource Type.Micro}" Padding="4,1" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="6" Text="{Binding CurrentLap}" Style="{StaticResource DataCellNumeric}"
                                                   Visibility="{Binding ColumnVisibility.ShowLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="7" Text="{Binding LastLapDisplay}" Style="{StaticResource DataCellNumeric}"
                                                   Visibility="{Binding ColumnVisibility.ShowLastLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="8" Text="{Binding BestLapDisplay}" Style="{StaticResource DataCellNumeric}"
                                                   Foreground="{Binding BestLapForeground}"
                                                   Visibility="{Binding ColumnVisibility.ShowBestLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="9" Text="{Binding GapDisplay}" Style="{StaticResource DataCellNumeric}"
                                                   Foreground="{StaticResource State.Accent}" FontWeight="Bold"
                                                   Visibility="{Binding ColumnVisibility.ShowGap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
