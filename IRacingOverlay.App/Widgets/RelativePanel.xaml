<UserControl x:Class="IRacingOverlay.App.Widgets.RelativePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
             x:Name="Root">
    <!-- Same columns, cell styles and row template as StandingsPanel, from the shared
         Themes/DriverTable.xaml. The two tables differ only in what their GAP column means and in
         which rows the builder hands them. -->
    <Border Style="{StaticResource OverlayPanel}" Padding="10,8">
        <DockPanel>
            <!-- The session information itself: kept here, collapsed, until TableInfoBands moves each
                 element into the slot the options give it. -->
            <StackPanel x:Name="InfoHolder" DockPanel.Dock="Top" Visibility="Collapsed">
                <!-- The session being run (RACE, QUALIFYING, PRACTICE). Trimmed rather than allowed
                     to push the band wider than the table. -->
                <TextBlock x:Name="SessionTypeText" Text="" Style="{StaticResource ColumnHeader}" TextTrimming="CharacterEllipsis"/>
                <!-- SOF describes the whole lobby, so it belongs here once rather than as a column. -->
                <TextBlock x:Name="SofText" Text="" Style="{StaticResource ColumnHeader}"/>
                <StackPanel x:Name="SessionLapsField" Orientation="Horizontal">
                    <TextBlock Text="LAP" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="SessionLapsText" Text="—" Style="{StaticResource DataCell}"
                               FontFamily="{DynamicResource Theme.NumericFontFamily}" Foreground="{StaticResource Text.Primary}"/>
                </StackPanel>
                <StackPanel x:Name="SessionTimeField" Orientation="Horizontal">
                    <TextBlock Text="TIME" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="SessionTimeText" Text="—" Style="{StaticResource DataCell}"
                               FontFamily="{DynamicResource Theme.NumericFontFamily}" Foreground="{StaticResource Text.Primary}"/>
                </StackPanel>
                <!-- Conditions, shown when picked: brake bias, then the weather in the Weather and
                     Track & session widgets' own icons. -->
                <StackPanel x:Name="BrakeBiasField" Orientation="Horizontal" ToolTip="Brake bias">
                    <TextBlock Text="BB" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="BrakeBiasText" Text="—" Style="{StaticResource DataCell}"
                               FontFamily="{DynamicResource Theme.NumericFontFamily}" Foreground="{StaticResource Text.Primary}"/>
                </StackPanel>
                <StackPanel x:Name="AirTempField" Orientation="Horizontal" ToolTip="Air temperature">
                    <w:WeatherIcon x:Name="AirTempIcon" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,5,0"
                                   SunBrush="{StaticResource State.Accent}" MoonBrush="{StaticResource Text.Primary}"
                                   CloudBrush="{StaticResource Text.Secondary}" CloudShadeBrush="{StaticResource Text.Muted}"
                                   RainBrush="{StaticResource State.Info}"/>
                    <TextBlock x:Name="AirTempText" Text="—" Style="{StaticResource DataCell}"
                               FontFamily="{DynamicResource Theme.NumericFontFamily}" Foreground="{StaticResource Text.Primary}"/>
                </StackPanel>
                <StackPanel x:Name="TrackTempField" Orientation="Horizontal" ToolTip="Track temperature">
                    <Path Data="{StaticResource Icon.Road}" Fill="{StaticResource Text.Secondary}" Stretch="Uniform" Height="12"
                          VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="TrackTempText" Text="—" Style="{StaticResource DataCell}"
                               FontFamily="{DynamicResource Theme.NumericFontFamily}" Foreground="{StaticResource Text.Primary}"/>
                </StackPanel>
                <StackPanel x:Name="HumidityField" Orientation="Horizontal" ToolTip="Relative humidity">
                    <Path Data="{StaticResource Icon.Drop}" Fill="{StaticResource Text.Secondary}" Stretch="Uniform" Height="11"
                          VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="HumidityText" Text="—" Style="{StaticResource DataCell}"
                               FontFamily="{DynamicResource Theme.NumericFontFamily}" Foreground="{StaticResource Text.Primary}"/>
                </StackPanel>
                <!-- The player's incidents over the limit, amber and red like the Incidents widget. -->
                <StackPanel x:Name="IncidentsField" Orientation="Horizontal" ToolTip="Incidents">
                    <TextBlock Text="x" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="IncidentsText" Text="—" Style="{StaticResource DataCell}"
                               FontFamily="{DynamicResource Theme.NumericFontFamily}" Foreground="{StaticResource Text.Primary}"/>
                </StackPanel>
            </StackPanel>

            <!-- Session information above the table (see TableInfoBands): three slots, left, centre
                 and right, each holding whatever the options put there. The band takes no room when
                 nothing is in it. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,7"
                  Visibility="{Binding Options.ShowTopInfo, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TopLeftSlot" Orientation="Horizontal" HorizontalAlignment="Left"/>
                <StackPanel x:Name="TopCenterSlot" Grid.Column="1" Orientation="Horizontal" Margin="12,0"/>
                <StackPanel x:Name="TopRightSlot" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Grid>

            <!-- The column names. Collapsed when switched off, which takes its height out of the
                 widget: the window sizes to its content. -->
            <Grid DockPanel.Dock="Top" Margin="{StaticResource RulerInset}"
                  Visibility="{Binding Options.ShowColumnHeaders, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Options.Columns.Width0, ElementName=Root}"/>
                    <ColumnDefinition Width="{Binding Options.Columns.Width1, ElementName=Root}"/>
                    <ColumnDefinition Width="{Binding Options.Columns.Width2, ElementName=Root}"/>
                    <ColumnDefinition Width="{Binding Options.Columns.Width3, ElementName=Root}"/>
                    <ColumnDefinition Width="{Binding Options.Columns.Width4, ElementName=Root}"/>
                    <ColumnDefinition Width="{Binding Options.Columns.Width5, ElementName=Root}"/>
                    <ColumnDefinition Width="{Binding Options.Columns.Width6, ElementName=Root}"/>
                    <ColumnDefinition Width="{Binding Options.Columns.Width7, ElementName=Root}"/>
                    <ColumnDefinition Width="{Binding Options.Columns.Width8, ElementName=Root}"/>
                    <ColumnDefinition Width="{Binding Options.Columns.Width9, ElementName=Root}"/>
                    <ColumnDefinition Width="{Binding Options.Columns.Width10, ElementName=Root}"/>
                    <ColumnDefinition Width="{Binding Options.Columns.Width11, ElementName=Root}"/>
                    <!-- Matches the rows' fastest-lap slot, so the columns stay aligned. -->
                    <ColumnDefinition Width="{Binding Options.FastestLapMarkWidth, ElementName=Root}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="{Binding Options.Columns.Position, ElementName=Root}" Text="POS" Style="{StaticResource HeadNumeric}"
                           Visibility="{Binding Options.ShowPosition, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="{Binding Options.Columns.CarNumber, ElementName=Root}" Text="CAR" Style="{StaticResource HeadCentered}"
                           Visibility="{Binding Options.ShowCarNumber, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="{Binding Options.Columns.Driver, ElementName=Root}" Text="DRIVER" Style="{StaticResource HeadText}"
                           Visibility="{Binding Options.ShowDriver, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="{Binding Options.Columns.LastPitStop, ElementName=Root}" Text="LAST PIT" Style="{StaticResource HeadCentered}"
                           Visibility="{Binding Options.ShowLastPitStop, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="{Binding Options.Columns.TireCompound, ElementName=Root}" Text="TIRE" Style="{StaticResource HeadCentered}"
                           Visibility="{Binding Options.ShowTireCompound, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="{Binding Options.Columns.IRating, ElementName=Root}" Grid.ColumnSpan="2" Text="iR" Style="{StaticResource HeadCentered}"
                           Visibility="{Binding Options.ShowIRating, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="{Binding Options.Columns.License, ElementName=Root}" Text="SR" Style="{StaticResource HeadCentered}"
                           Visibility="{Binding Options.ShowLicense, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="{Binding Options.Columns.Lap, ElementName=Root}" Text="LAP" Style="{StaticResource HeadNumeric}"
                           Visibility="{Binding Options.ShowLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="{Binding Options.Columns.BestLap, ElementName=Root}" Text="BEST" Style="{StaticResource HeadNumeric}"
                           Visibility="{Binding Options.ShowBestLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="{Binding Options.Columns.LastLap, ElementName=Root}" Text="LAST" Style="{StaticResource HeadNumeric}"
                           Visibility="{Binding Options.ShowLastLap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
                <TextBlock Grid.Column="{Binding Options.Columns.Gap, ElementName=Root}" Text="GAP" Style="{StaticResource HeadNumeric}"
                           Visibility="{Binding Options.ShowGap, ElementName=Root, Converter={StaticResource ColumnVisibilityConverter}}"/>
            </Grid>

            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Surface.DividerFade}" Margin="0,0,0,4"/>

            <!-- Session progress: one value each for the whole field, so a footer rather than a
                 column — the player's lap out of the race's laps (estimated from their pace in a
                 timed race) and the clock. Docked before the rows so it never scrolls with them. -->
            <!-- And below it, under a hairline; the same three slots. -->
            <Grid DockPanel.Dock="Bottom" Margin="0,5,0,0"
                  Visibility="{Binding Options.ShowFooter, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Border Height="1" VerticalAlignment="Top" Background="{StaticResource Surface.DividerFade}"/>
                <Grid Margin="8,6,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="BottomLeftSlot" Orientation="Horizontal" HorizontalAlignment="Left"/>
                    <StackPanel x:Name="BottomCenterSlot" Grid.Column="1" Orientation="Horizontal" Margin="12,0"/>
                    <StackPanel x:Name="BottomRightSlot" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>

            <Grid>
                <TextBlock Text="Waiting for iRacing telemetry…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count, ElementName=Root}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Rows, ElementName=Root}">
                    <ItemsControl.ItemTemplate>
                        <!-- Rows sit in fixed RowSlots; the implicit per-DataType templates pick the
                             visual for whatever row the slot holds this tick. -->
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Value}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
