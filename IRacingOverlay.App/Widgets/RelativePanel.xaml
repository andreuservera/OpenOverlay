<UserControl x:Class="IRacingOverlay.App.Widgets.RelativePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IRacingOverlay.App.ViewModels"
             x:Name="Root">
    <Border Background="#E6141414" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="6">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="RELATIVE" Foreground="#888888" FontSize="11"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <Grid>
                <TextBlock Text="Waiting for iRacing telemetry…" Foreground="#777777" FontSize="12"
                           FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count, ElementName=Root}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Rows, ElementName=Root}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RelativeRow}">
                            <Border Background="{Binding RowBackground}" Margin="0,1" Padding="2,1" CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding ClassColor}" CornerRadius="2" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding CarNumber}" Foreground="Black" FontWeight="Bold"
                                                   HorizontalAlignment="Center" FontSize="12"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding GapDisplay}" Foreground="#FFD24D" FontSize="12"
                                               FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
