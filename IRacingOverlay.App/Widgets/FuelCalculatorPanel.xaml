<UserControl x:Class="IRacingOverlay.App.Widgets.FuelCalculatorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IRacingOverlay.App.Localization"
             x:Name="Root"
             xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- One arrangement, top to bottom (docs/widgets-style.md §5): fuel left in big figures with
             the laps it lasts on the right; the tank bar; the per-lap usage in four columns; and,
             under a hairline, the fuel needed to the finish with what to add on the right. Every
             block follows its own switch; hidden usage cells close up. -->
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource ColumnHeader}">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="CellCaption" TargetType="TextBlock" BasedOn="{StaticResource ColumnHeader}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LineHeight" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="CellValue" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FooterValue" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- The unit after a figure, muted, sitting on the figure's baseline (same TextBlock, its own Run). -->
        <Style x:Key="UnitRun" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="UsageCell" TargetType="StackPanel">
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <ov:WidgetFrame Padding="12,5,12,7" Title="{loc:T widget.FuelCalculator.name}">
        <StackPanel MinWidth="226">
            <!-- Fuel left, and the laps it lasts. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="FuelRemainingCell"
                            Visibility="{Binding Options.ShowFuelRemaining, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:T fuel.fuelLeft}" Style="{StaticResource Caption}"/>
                    <TextBlock Style="{StaticResource DisplayValue}" FontSize="34" LineHeight="36">
                        <Run x:Name="LevelText" Text="—"/><Run x:Name="LevelUnitText" Text="" FontSize="15" Style="{StaticResource UnitRun}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,0,2"
                            Visibility="{Binding Options.ShowLapsRemaining, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:T fuel.lapsLeft}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="LapsRemainingText" Text="—" Style="{StaticResource ValueText}" FontSize="24" LineHeight="26"
                               FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- The tank: level in green, and a 2px mark where the fuel needed to the finish would
                 reach, in the warning colour (hidden until it can be projected). -->
            <Border x:Name="LevelTrack" Style="{StaticResource MeterTrack}" Height="6" Margin="0,8,0,0"
                    Visibility="{Binding Options.ShowFuelBar, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Rectangle x:Name="LevelFill" Fill="{StaticResource State.Positive}" HorizontalAlignment="Left" Width="0"
                               RadiusX="3" RadiusY="3"/>
                    <Rectangle x:Name="NeededMark" Fill="{StaticResource State.Warning}" Width="2" HorizontalAlignment="Left"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Per-lap usage: up to four columns, each switchable, in the order the options give. -->
            <StackPanel Margin="0,9,0,0" Visibility="{Binding Options.ShowAnyUsage, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:T fuel.perLap}" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                <UniformGrid x:Name="UsageCells" Rows="1" Margin="0,0,-10,0">
                    <StackPanel x:Name="LastLapCell" Style="{StaticResource UsageCell}"
                                Visibility="{Binding Options.ShowLastLap, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T fuel.last}" Style="{StaticResource CellCaption}"/>
                        <TextBlock x:Name="LastLapText" Text="—" Style="{StaticResource CellValue}"/>
                    </StackPanel>
                    <StackPanel x:Name="AverageCell" Style="{StaticResource UsageCell}"
                                Visibility="{Binding Options.ShowAverage, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <!-- Says which window the average covers, so the number is never ambiguous. -->
                        <TextBlock x:Name="AverageLabel" Text="{loc:T fuel.avg}" Style="{StaticResource CellCaption}"/>
                        <TextBlock x:Name="AverageText" Text="—" Style="{StaticResource CellValue}"/>
                    </StackPanel>
                    <StackPanel x:Name="MinimumCell" Style="{StaticResource UsageCell}"
                                Visibility="{Binding Options.ShowMinimum, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T fuel.min}" Style="{StaticResource CellCaption}"/>
                        <TextBlock x:Name="MinText" Text="—" Style="{StaticResource CellValue}"/>
                    </StackPanel>
                    <StackPanel x:Name="MaximumCell" Style="{StaticResource UsageCell}"
                                Visibility="{Binding Options.ShowMaximum, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T fuel.max}" Style="{StaticResource CellCaption}"/>
                        <TextBlock x:Name="MaxText" Text="—" Style="{StaticResource CellValue}"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>

            <!-- Footer: what it takes to finish, and what to add at the stop. -->
            <Border Margin="0,9,0,0" Padding="0,7,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Surface.Divider}"
                    Visibility="{Binding Options.ShowAnyFooter, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="FuelToFinishCell"
                                Visibility="{Binding Options.ShowFuelToFinish, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T fuel.toFinish}" Style="{StaticResource Caption}"/>
                        <TextBlock Style="{StaticResource FooterValue}">
                            <Run x:Name="FuelToFinishText" Text="—"/><Run x:Name="FuelToFinishUnitText" Text="" Style="{StaticResource UnitRun}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel x:Name="RefuelCell" Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0"
                                Visibility="{Binding Options.ShowRefuel, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T fuel.refuel}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="RefuelLine" Style="{StaticResource FooterValue}" HorizontalAlignment="Right">
                            <Run x:Name="RefuelText" Text="—"/><Run x:Name="RefuelUnitText" Text=""/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ov:WidgetFrame>
</UserControl>
