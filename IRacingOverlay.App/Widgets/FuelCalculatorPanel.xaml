<UserControl x:Class="IRacingOverlay.App.Widgets.FuelCalculatorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="10">
        <StackPanel>
            <TextBlock Text="FUEL CALC" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="11"
                       FontWeight="Bold" Margin="0,0,0,4"/>

            <!-- Fuel remaining: the headline number, big enough to read at a glance mid-corner. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding Options.ShowFuelRemaining, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="LevelText" Text="—" FontSize="30" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                <TextBlock Text=" L" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
            </StackPanel>

            <Border x:Name="LevelTrack" Background="#2A2A2A" CornerRadius="3" Height="8" Margin="0,6,0,4"
                    Visibility="{Binding Options.ShowFuelBar, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Rectangle x:Name="LevelFill" Fill="#FFB238" HorizontalAlignment="Left" Width="0"/>
            </Border>

            <!-- Per-lap usage: up to four compact columns, each independently toggleable. -->
            <Grid Margin="0,4,0,0"
                  Visibility="{Binding Options.ShowAnyUsage, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Visibility="{Binding Options.ShowLastLap, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="LAST" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="LastLapText" Text="—" Style="{StaticResource StatValue}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Visibility="{Binding Options.ShowAverage, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <TextBlock x:Name="AverageLabel" Text="AVG" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="AverageText" Text="—" Style="{StaticResource StatValue}" Foreground="#FFB238"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Visibility="{Binding Options.ShowMinimum, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="MIN" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="MinText" Text="—" Style="{StaticResource StatValue}"/>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Visibility="{Binding Options.ShowMaximum, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="MAX" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="MaxText" Text="—" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Grid>

            <Rectangle Height="1" Fill="#2A2A2A" Margin="0,8,0,6"
                       Visibility="{Binding Options.ShowAnyUsage, ElementName=Root, Converter={StaticResource BoolToVis}}"/>

            <Grid Margin="0,0,0,2"
                  Visibility="{Binding Options.ShowLapsRemaining, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="LAPS LEFT" Style="{StaticResource RowLabel}"/>
                <TextBlock x:Name="LapsRemainingText" Text="—" Style="{StaticResource RowValue}"/>
            </Grid>

            <Grid Margin="0,0,0,2"
                  Visibility="{Binding Options.ShowFuelToFinish, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="TO FINISH" Style="{StaticResource RowLabel}"/>
                <TextBlock x:Name="FuelDeltaText" Text="—" Style="{StaticResource RowValue}"/>
            </Grid>

            <Grid Margin="0,0,0,2"
                  Visibility="{Binding Options.ShowRefuel, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="REFUEL" Style="{StaticResource RowLabel}"/>
                <TextBlock x:Name="RefuelText" Text="—" Style="{StaticResource RowValue}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
