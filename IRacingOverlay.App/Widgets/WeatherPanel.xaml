<UserControl x:Class="IRacingOverlay.App.Widgets.WeatherPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
             x:Name="Root">
    <!-- Three sections — temperatures, wind, forecast — stacked, or side by side in compact mode.
         Every element binds its own toggle; SpacedStackPanel only spaces visible children and the
         section/divider flags are derived in WeatherOptions, so hiding anything closes the gap. -->
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="FontSize" Value="{StaticResource Type.Label}"/>
            <Setter Property="LineHeight" Value="{StaticResource Line.Label}"/>
            <Setter Property="Visibility" Value="{Binding Options.ShowLabels, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
        </Style>
        <Style x:Key="StackedCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="InlineCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock" BasedOn="{StaticResource UnitLabel}">
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="2,0,0,2"/>
        </Style>
        <!-- The headline number. Steps down a size in compact mode so the strip stays one line tall. -->
        <Style x:Key="AirValue" TargetType="TextBlock" BasedOn="{StaticResource DisplayValueSmall}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Options.Compact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="FontSize" Value="{StaticResource Type.ValueLarge}"/>
                    <Setter Property="LineHeight" Value="{StaticResource Line.ValueLarge}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionStack" TargetType="w:SpacedStackPanel">
            <Setter Property="Spacing" Value="9"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Options.Compact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Orientation" Value="Horizontal"/>
                    <Setter Property="Spacing" Value="12"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Section" TargetType="FrameworkElement">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface.Divider}"/>
            <Setter Property="Height" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Options.Compact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Height" Value="NaN"/>
                    <Setter Property="Width" Value="1"/>
                    <Setter Property="Margin" Value="0,3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayPanel}" Padding="14,10">
        <w:SpacedStackPanel Style="{StaticResource SectionStack}">
            <!-- Temperatures: air is the headline; track sits on a chip so the two never read alike. -->
            <w:SpacedStackPanel Orientation="Horizontal" Spacing="14" Style="{StaticResource Section}"
                                Visibility="{Binding Options.ShowTemperatures, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Bottom" ToolTip="Air temperature"
                            Visibility="{Binding Options.ShowAirTemp, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="AIR" Style="{StaticResource StackedCaption}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AirTempText" Text="—" Style="{StaticResource AirValue}"/>
                        <TextBlock x:Name="AirUnitText" Text="°C" Style="{StaticResource Unit}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom" ToolTip="Track surface temperature"
                            Visibility="{Binding Options.ShowTrackTemp, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="TRACK" Style="{StaticResource StackedCaption}"/>
                    <Border Background="{StaticResource Surface.Chip}" BorderBrush="{StaticResource Surface.ChipBorder}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Chip}" Padding="6,1,5,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TrackTempText" Text="—" Style="{StaticResource ValueTextLarge}"/>
                            <TextBlock x:Name="TrackUnitText" Text="°C" Style="{StaticResource Unit}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </w:SpacedStackPanel>

            <Border Style="{StaticResource Divider}"
                    Visibility="{Binding Options.ShowFirstDivider, ElementName=Root, Converter={StaticResource BoolToVis}}"/>

            <!-- Wind and humidity. The dial's notch is the car's nose; the compass ring turns with the
                 car, and the arrow runs from where the wind comes from to where it blows. -->
            <w:SpacedStackPanel Orientation="Horizontal" Spacing="11" Style="{StaticResource Section}"
                                Visibility="{Binding Options.ShowWindSection, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <w:WindCompass x:Name="WindDial" VerticalAlignment="Center"
                               Width="{Binding Options.ArrowPixels, ElementName=Root}" Height="{Binding Options.ArrowPixels, ElementName=Root}"
                               RingBrush="{StaticResource Surface.Track}" LetterBrush="{StaticResource Text.Muted}"
                               NorthBrush="{StaticResource State.Negative}" NoseBrush="{StaticResource Text.Primary}"
                               ArrowBrush="{StaticResource State.Info}"
                               Visibility="{Binding Options.ShowWindArrow, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
                <w:SpacedStackPanel Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" ToolTip="Wind speed"
                                Visibility="{Binding Options.ShowWindSpeed, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="WIND" Style="{StaticResource InlineCaption}"/>
                        <TextBlock x:Name="WindSpeedText" Text="—" Style="{StaticResource ValueText}"/>
                        <TextBlock x:Name="WindUnitText" Text="km/h" Style="{StaticResource Unit}" Margin="3,0,0,1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Relative humidity"
                                Visibility="{Binding Options.ShowHumidity, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <Path Data="M5,0 C6.5,2.5 10,6.2 10,9 A5,5 0 0 1 0,9 C0,6.2 3.5,2.5 5,0 Z" Fill="{StaticResource Text.Muted}"
                              Width="11" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="HumidityText" Text="—" Style="{StaticResource ValueText}"/>
                    </StackPanel>
                </w:SpacedStackPanel>
            </w:SpacedStackPanel>

            <Border Style="{StaticResource Divider}"
                    Visibility="{Binding Options.ShowSecondDivider, ElementName=Root, Converter={StaticResource BoolToVis}}"/>

            <!-- Forecast: the sky icon beside what it means — the sky in words, the chance of rain with
                 a meter, and how wet the track already is — so the row fills the panel's width
                 instead of a lone icon floating in the middle of it. -->
            <w:SpacedStackPanel Orientation="Horizontal" Spacing="12" Style="{StaticResource Section}"
                                Visibility="{Binding Options.ShowForecastSection, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <w:WeatherIcon x:Name="ForecastIcon" VerticalAlignment="Center"
                               Width="{Binding Options.IconPixels, ElementName=Root}" Height="{Binding Options.IconPixels, ElementName=Root}"
                               SunBrush="{StaticResource State.Accent}" MoonBrush="{StaticResource Text.Primary}"
                               CloudBrush="{StaticResource Text.Secondary}" CloudShadeBrush="{StaticResource Text.Muted}"
                               RainBrush="{StaticResource State.Info}"
                               Visibility="{Binding Options.ShowForecast, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
                <w:SpacedStackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="ConditionText" Text="—" Style="{StaticResource FieldLabel}"
                               FontSize="{StaticResource Type.Label}" LineHeight="{StaticResource Line.Label}"
                               Foreground="{StaticResource Text.Secondary}"
                               Visibility="{Binding Options.ShowForecast, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel ToolTip="Chance of rain"
                                Visibility="{Binding Options.ShowRainProbability, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RAIN" Style="{StaticResource InlineCaption}"/>
                            <TextBlock x:Name="RainChanceText" Text="—" Style="{StaticResource ValueText}"/>
                        </StackPanel>
                        <Border Style="{StaticResource MeterTrack}" Height="6" Margin="0,3,0,0">
                            <Rectangle x:Name="RainFill" RadiusX="3" RadiusY="3" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="RainFillScale" ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Track surface"
                                Visibility="{Binding Options.ShowTrackWetness, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="SURFACE" Style="{StaticResource InlineCaption}"/>
                        <TextBlock x:Name="WetnessText" Text="—" Style="{StaticResource ValueText}"/>
                    </StackPanel>
                </w:SpacedStackPanel>
            </w:SpacedStackPanel>
        </w:SpacedStackPanel>
    </Border>
</UserControl>
