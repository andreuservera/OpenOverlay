<UserControl x:Class="IRacingOverlay.App.Widgets.DeltaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Horizontal padding rebalanced against the larger delta numeral, so the panel keeps its
         original footprint. -->
    <Border Style="{StaticResource OverlayPanel}" Padding="11.5,10">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="LabelText" Text="VS SESSION BEST" Style="{StaticResource PanelTitle}"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock x:Name="DeltaText" Text="—" Style="{StaticResource DisplayValue}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
