<UserControl x:Class="IRacingOverlay.App.Widgets.DeltaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="#E6141414" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="10">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="LabelText" Text="VS SESSION BEST" Foreground="#888888" FontSize="11"
                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
            <TextBlock x:Name="DeltaText" Text="—" FontSize="32" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" FontFamily="Consolas"/>
        </StackPanel>
    </Border>
</UserControl>
