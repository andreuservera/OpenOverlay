<UserControl x:Class="IRacingOverlay.App.Widgets.FuelPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource Theme.PanelBackground}" BorderBrush="{DynamicResource Theme.PanelBorder}"
            BorderThickness="{DynamicResource Theme.PanelBorderThickness}" CornerRadius="{DynamicResource Theme.PanelCornerRadius}"
            TextElement.FontFamily="{DynamicResource Theme.FontFamily}" Padding="10">
        <StackPanel>
            <TextBlock Text="FUEL" Foreground="{DynamicResource Theme.LabelForeground}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="LapsOfFuelText" Text="—" FontSize="30" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                <TextBlock Text=" laps" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
            </StackPanel>
            <Border x:Name="LevelTrack" Background="#2A2A2A" CornerRadius="3" Height="8" Margin="0,6,0,4">
                <Rectangle x:Name="LevelFill" Fill="#FFB238" HorizontalAlignment="Left" Width="0"/>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LevelText" Grid.Column="0" Text="— L" Foreground="#CCCCCC" FontSize="12"/>
                <TextBlock x:Name="PerLapText" Grid.Column="1" Text="—" Foreground="#CCCCCC" FontSize="12" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
