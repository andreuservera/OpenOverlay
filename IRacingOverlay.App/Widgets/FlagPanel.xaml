<UserControl x:Class="IRacingOverlay.App.Widgets.FlagPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent"
             FontFamily="{DynamicResource Theme.FontFamily}">
    <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="FlagsStack" Orientation="Vertical" Background="Transparent"/>
    </ScrollViewer>
</UserControl>
