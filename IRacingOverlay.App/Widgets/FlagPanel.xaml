<UserControl x:Class="IRacingOverlay.App.Widgets.FlagPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IRacingOverlay.App.ViewModels"
             xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
             x:Name="Root"
             xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
             xmlns:loc="clr-namespace:IRacingOverlay.App.Localization">
    <UserControl.Resources>
        <Style x:Key="FlagName" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{DynamicResource Theme.NumericFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="FlagDescription" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
            <Setter Property="FontSize" Value="{StaticResource Type.Micro}"/>
            <Setter Property="LineHeight" Value="{StaticResource Line.Micro}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Theme.DataFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <!-- One flag: the flag graphic and its name, straight on the panel; several flags are
             separated by the same 1px rule as the table rows. Every flag is the same size, kept
             compact. A new flag slides in from the left as it fades in, its swatch popping up to
             size; a yellow one blinks (1 s, on/off, no easing) unless the system asks for less motion. -->
        <DataTemplate DataType="{x:Type vm:FlagState}">
            <Border x:Name="Row" BorderBrush="{StaticResource Surface.RowDivider}" BorderThickness="0,1,0,0" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="Slide" X="-14"/>
                </Border.RenderTransform>
                <DockPanel x:Name="Content" Margin="4,5,6,5">
                    <w:FlagIcon x:Name="Icon" DockPanel.Dock="Left" Flag="{Binding}" Width="42" Height="28"
                                VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <w:FlagIcon.RenderTransform>
                            <ScaleTransform x:Name="Pop" ScaleX="0.7" ScaleY="0.7"/>
                        </w:FlagIcon.RenderTransform>
                    </w:FlagIcon>
                    <StackPanel x:Name="Text" Width="160" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Options.ShowText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Name="NameText" Text="{Binding Name}" Style="{StaticResource FlagName}"
                                   Visibility="{Binding Options.ShowNameText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock x:Name="DescriptionText" Text="{Binding Description}" Style="{StaticResource FlagDescription}"
                                   Visibility="{Binding Options.ShowDescriptionText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.4">
                                <DoubleAnimation.EasingFunction>
                                    <QuinticEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.45">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <!-- The rule goes between flags, so not above the first. -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="{x:Static vm:FlagKind.Yellow}"/>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="YellowBlink">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" Duration="0:0:2">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.25"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="YellowBlink"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Options.IconOnTop, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="Icon" Property="DockPanel.Dock" Value="Top"/>
                    <Setter TargetName="Text" Property="Width" Value="120"/>
                    <Setter TargetName="Text" Property="Margin" Value="0,7,0,0"/>
                    <Setter TargetName="NameText" Property="TextAlignment" Value="Center"/>
                    <Setter TargetName="DescriptionText" Property="TextAlignment" Value="Center"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Options.ShowText, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                    <Setter TargetName="Content" Property="Margin" Value="4,5,4,5"/>
                    <!-- Docked top so a smaller secondary icon centres under the primary one. -->
                    <Setter TargetName="Icon" Property="DockPanel.Dock" Value="Top"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ov:WidgetFrame x:Name="Frame" Padding="6,3" Title="{loc:T widget.Flag.name}">
        <ItemsControl ItemsSource="{Binding Flags, ElementName=Root}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Options.IsHorizontal, ElementName=Root}" Value="True">
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
        </ItemsControl>
    </ov:WidgetFrame>
</UserControl>
