<UserControl x:Class="IRacingOverlay.App.Widgets.FlagPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border x:Name="FlagBorder" Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" Padding="10">
        <Grid>
            <UniformGrid x:Name="CheckerPattern" Rows="4" Columns="4" Visibility="Collapsed"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                <Ellipse x:Name="MeatballDot" Width="14" Height="14" Fill="#FF8C1A" Margin="0,0,8,0" Visibility="Collapsed"/>
                <TextBlock x:Name="FlagText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#555555"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
