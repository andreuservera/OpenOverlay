<UserControl x:Class="IRacingOverlay.App.Widgets.FlagPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IRacingOverlay.App.ViewModels"
             xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="FlagName" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
            <Setter Property="FontSize" Value="{StaticResource Type.Value}"/>
            <Setter Property="LineHeight" Value="{StaticResource Line.Value}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{DynamicResource Theme.NumericFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="FlagDescription" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
            <Setter Property="FontSize" Value="{StaticResource Type.Micro}"/>
            <Setter Property="LineHeight" Value="{StaticResource Line.Micro}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Theme.DataFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- One flag: the same bar-and-wash row as the timing tables, in the flag's accent colour,
             with the flag graphic beside its name. Every flag is the same size, first or not. -->
        <DataTemplate DataType="{x:Type vm:FlagState}">
            <Grid Margin="2">
                <Border Background="{StaticResource Row.Base}" CornerRadius="{StaticResource Radius.Row}"/>
                <Border CornerRadius="{StaticResource Radius.Row}"
                        Background="{Binding AccentColor, Converter={StaticResource ClassGradientConverter}, ConverterParameter=0.3}"/>
                <Border Width="3" HorizontalAlignment="Left" CornerRadius="{StaticResource Radius.RowEdge}"
                        Background="{Binding AccentColor}"/>
                <DockPanel x:Name="Content" Margin="11,7,12,7">
                    <w:FlagIcon x:Name="Icon" DockPanel.Dock="Left" Flag="{Binding}" Width="48" Height="32"
                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="Text" Width="200" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Options.ShowText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Name="NameText" Text="{Binding Name}" Style="{StaticResource FlagName}"
                                   Visibility="{Binding Options.ShowNameText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock x:Name="DescriptionText" Text="{Binding Description}" Style="{StaticResource FlagDescription}"
                                   Visibility="{Binding Options.ShowDescriptionText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Options.IconOnTop, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="Icon" Property="DockPanel.Dock" Value="Top"/>
                    <Setter TargetName="Text" Property="Width" Value="136"/>
                    <Setter TargetName="Text" Property="Margin" Value="0,7,0,0"/>
                    <Setter TargetName="NameText" Property="TextAlignment" Value="Center"/>
                    <Setter TargetName="DescriptionText" Property="TextAlignment" Value="Center"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Options.ShowText, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                    <Setter TargetName="Content" Property="Margin" Value="10,7,8,7"/>
                    <!-- Docked top so a smaller secondary icon centres under the primary one. -->
                    <Setter TargetName="Icon" Property="DockPanel.Dock" Value="Top"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="Frame" Style="{StaticResource OverlayPanel}" Padding="6">
        <ItemsControl ItemsSource="{Binding Flags, ElementName=Root}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Options.IsHorizontal, ElementName=Root}" Value="True">
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
        </ItemsControl>
    </Border>
</UserControl>
