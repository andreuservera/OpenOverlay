<Application x:Class="IRacingOverlay.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IRacingOverlay.App"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Type scale, semantic state palette and the shared TextBlock styles. Merged here
                     (not per-window) so floating widgets and the Dashboard resolve identical values.
                     Theme dictionaries never override these — only the chrome keys below. -->
                <ResourceDictionary Source="Themes/DesignTokens.xaml"/>
                <!-- The driver-table column ruler and row template, shared by Standings and
                     Relative. Merged at application level, after the tokens it builds on: a
                     dictionary can rely on StaticResource lookups into earlier entries of the same
                     MergedDictionaries collection, which is what keeps the styles below resolvable. -->
                <ResourceDictionary Source="Themes/DriverTable.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
              Default ("Classic") dashboard theme, application-wide. Floating widgets always resolve
              these (they never merge a theme dictionary of their own), so they keep this look
              regardless of what theme is picked for the Dashboard. DashboardWindow overrides these same
              keys in its own Resources when a different theme is selected, which DynamicResource lookups
              from inside that window find first.
            -->
            <RadialGradientBrush x:Key="Theme.WindowBackground" Center="0.5,0.35" RadiusX="0.95" RadiusY="0.95">
                <GradientStop Color="#161C24" Offset="0"/>
                <GradientStop Color="#05070A" Offset="1"/>
            </RadialGradientBrush>
            <!-- The widget frame (docs/widgets-style.md): bg #0E1116 at 84 %, a 1px edge in the border
                 colour at 70 %, 8px corners. Flat, no gradients: the opacity setting fades exactly
                 this background (see Overlay/BackgroundOpacity.cs) and never the data on it. -->
            <SolidColorBrush x:Key="Theme.PanelBackground" Color="#D60E1116"/>
            <SolidColorBrush x:Key="Theme.PanelBorder" Color="#B3262C36"/>
            <!-- The optional header strip: surface #161A21 at 70 %, over the panel background. -->
            <SolidColorBrush x:Key="Theme.HeaderBackground" Color="#B3161A21"/>
            <Thickness x:Key="Theme.PanelBorderThickness">1</Thickness>
            <CornerRadius x:Key="Theme.PanelCornerRadius">8</CornerRadius>
            <!-- Widget titles: text-2. -->
            <SolidColorBrush x:Key="Theme.LabelForeground" Color="#B4BCC8"/>

            <!--
              Font roles, so text is chosen by the job it does:
                FontFamily        — prose and anything not covered below.
                LabelFontFamily   — titles, column headers, captions.
                NumericFontFamily — the hero readouts (speed, RPM, delta, fuel, incidents).
                DataFontFamily    — table cells and values.
              Inside the widgets everything is Barlow Semi Condensed (bundled, SIL OFL, Medium /
              SemiBold / Bold): the same face as the landing page's widgets, with tabular figures so
              gaps and times never shift sideways. Bahnschrift stays as the plain-Windows fallback.
            -->
            <FontFamily x:Key="Theme.FontFamily">/OpenOverlay;component/Assets/Fonts/#Barlow Semi Condensed, Bahnschrift SemiCondensed, Segoe UI</FontFamily>
            <FontFamily x:Key="Theme.LabelFontFamily">/OpenOverlay;component/Assets/Fonts/#Barlow Semi Condensed, Bahnschrift SemiBold SemiCondensed, Segoe UI Semibold</FontFamily>
            <FontFamily x:Key="Theme.NumericFontFamily">/OpenOverlay;component/Assets/Fonts/#Barlow Semi Condensed, Bahnschrift SemiBold SemiCondensed, Segoe UI Semibold</FontFamily>
            <FontFamily x:Key="Theme.NameFontFamily">/OpenOverlay;component/Assets/Fonts/#Barlow Semi Condensed, Bahnschrift SemiCondensed, Segoe UI</FontFamily>
            <FontFamily x:Key="Theme.TableNumericFontFamily">/OpenOverlay;component/Assets/Fonts/#Barlow Semi Condensed, Bahnschrift SemiCondensed, Segoe UI</FontFamily>
            <FontFamily x:Key="Theme.DataFontFamily">/OpenOverlay;component/Assets/Fonts/#Barlow Semi Condensed, Bahnschrift SemiCondensed, Segoe UI</FontFamily>
            <!-- The big gear numeral: the same face at its heaviest cut. -->
            <FontFamily x:Key="Theme.GearFontFamily">/OpenOverlay;component/Assets/Fonts/#Barlow Semi Condensed, Bahnschrift SemiBold Condensed, Impact</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
