<UserControl x:Class="IRacingOverlay.App.ControlPanel.WidgetPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="clr-namespace:IRacingOverlay.App.ControlPanel"
             x:Name="Root">
    <!--
      The stage the real widget panel is placed on. Everything here is backdrop: the panel itself is
      inserted into Stage at runtime, unmodified, so what is drawn is the widget and not a drawing of
      the widget.
    -->
    <Grid>
        <!-- A blurred circuit rather than a flat colour. Overlay panels are translucent by design
             and now carry their own opacity, so judging them against a solid field is judging the
             wrong thing: how they hold up over asphalt, kerbs and a bright horizon is exactly the
             decision being made here. -->
        <cp:PreviewBackdrop x:Name="Backdrop"/>

        <!-- Fit, by default: a widget wider than the pane is scaled down until all of it shows,
             because a preview cut off at the tyre column hides exactly the column being changed.
             "Actual size" turns the fit off and the scrollbars on, for judging how much screen the
             widget will really cover. -->
        <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                      Padding="28" Focusable="False">
            <!-- The panel is scaled by the same ladder factor the widget uses, laid out through a
                 LayoutTransform so the space around it reflects the real footprint the widget will
                 occupy on screen. The Viewbox only ever shrinks it (DownOnly), and only while fitting.

                 The spacer grid takes at least the viewport's size so a small widget sits centred. -->
            <Grid MinWidth="{Binding ViewportWidth, ElementName=Viewport}"
                  MinHeight="{Binding ViewportHeight, ElementName=Viewport}">
                <Viewbox x:Name="Fitter" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Center" VerticalAlignment="Center" SizeChanged="Fitter_SizeChanged">
                    <!-- Opacity sits on the stage, not on the panel, so it composites over the backdrop
                         exactly the way the window's own opacity composites over iRacing. -->
                    <ContentPresenter x:Name="Stage" SizeChanged="Stage_SizeChanged">
                        <ContentPresenter.LayoutTransform>
                            <ScaleTransform x:Name="StageScale" ScaleX="1" ScaleY="1"/>
                        </ContentPresenter.LayoutTransform>
                    </ContentPresenter>
                </Viewbox>
            </Grid>
        </ScrollViewer>

        <!-- Corner caption: says out loud that the numbers are invented, so nobody mistakes a
             preview for a connection to iRacing. -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                Background="#99000000" CornerRadius="5" Padding="8,4">
            <TextBlock Text="SAMPLE DATA" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12"
                       FontWeight="SemiBold" Foreground="#B4BCC8"/>
        </Border>

        <!-- Fit / actual size. Says how far a fitted preview is scaled down, so a widget shown
             smaller than it will be is never mistaken for its real size. -->
        <ToggleButton x:Name="ActualSizeToggle" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                      Cursor="Hand" Focusable="False" Checked="ActualSizeToggle_Changed" Unchecked="ActualSizeToggle_Changed"
                      ToolTip="Fit shrinks the preview until the whole widget shows. Actual size shows it as big as it will be on screen; scroll to see the rest.">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="#99000000" CornerRadius="5" Padding="8,4"
                            BorderBrush="Transparent" BorderThickness="1">
                        <TextBlock x:Name="Caption" Text="{Binding FitCaption, ElementName=Root}"
                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#B4BCC8"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#66FFD24D"/>
                            <Setter TargetName="Caption" Property="Foreground" Value="#FFD24D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
    </Grid>
</UserControl>
