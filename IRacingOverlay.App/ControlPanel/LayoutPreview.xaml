<UserControl x:Class="IRacingOverlay.App.ControlPanel.LayoutPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IRacingOverlay.App.Localization"
             xmlns:cp="clr-namespace:IRacingOverlay.App.ControlPanel"
        xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
             IsHitTestVisible="False"
             SizeChanged="OnSizeChanged">
    <!-- Merged here too: StaticResource lookups run while this control is built, before it has a
         parent window to find the theme in. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ControlPanelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
      The Layouts page's preview: the selected layout's monitor, scaled down to fit the pane, with its
      widgets drawn by the real panels from the layout's own settings, as the editor's canvas draws
      them. Read-only; editing happens in the editor.

      The frame is scaled through a LayoutTransform rather than a Viewbox so the grid around it takes
      the frame's on-screen size. The resolution is said by the pane's header, never on the canvas,
      where it would sit over whatever widget is in that corner.
    -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border x:Name="Frame" BorderThickness="1" BorderBrush="{StaticResource Cp.BorderStrong}">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="FrameScale" ScaleX="1" ScaleY="1"/>
            </Border.LayoutTransform>
            <Grid x:Name="Surface" ClipToBounds="True">
                <cp:PreviewBackdrop x:Name="Backdrop"/>
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Panel}"
                                              ov:BackgroundOpacity.Value="{Binding BackgroundOpacity}"
                                              ov:WidgetFrame.ShowHeader="{Binding ShowHeader}">
                                <ContentPresenter.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding Factor}" ScaleY="{Binding Factor}"/>
                                </ContentPresenter.LayoutTransform>
                            </ContentPresenter>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <TextBlock x:Name="EmptyText" Text="{loc:T layoutPreview.noWidgetsYetAdd}"
                   Style="{StaticResource Cp.Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" Margin="12" Visibility="Collapsed"/>
    </Grid>
</UserControl>
