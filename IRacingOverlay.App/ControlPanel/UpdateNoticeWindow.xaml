<Window x:Class="IRacingOverlay.App.ControlPanel.UpdateNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenOverlay updated"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cp.Surface}" BorderBrush="{DynamicResource Cp.BorderStrong}" BorderThickness="1"
        FontFamily="{DynamicResource Theme.FontFamily}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        MouseLeftButtonDown="OnDrag">
    <!--
      Shown once, after an update, on top of the control panel: what changed at a glance, the rest
      one click away. Modeless and without a taskbar button, so it never gets in the way — OK or Esc
      dismisses it, and nothing is lost by ignoring it.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ControlPanelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>
        <Grid Margin="22,20,22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Cp.Accent}" VerticalAlignment="Top">
                <Path Data="M6,17 L11,7 L14,13 L18,7" Stretch="Uniform" Margin="9" Stroke="#101316" StrokeThickness="3"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="UPDATED" Style="{StaticResource Cp.Eyebrow}" Foreground="{StaticResource Cp.Accent}"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Cp.Title}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Cp.Hint}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Border BorderBrush="{StaticResource Cp.Border}" BorderThickness="0,1,0,0" Padding="22,14,22,6"
                Visibility="{Binding Heading, Converter={StaticResource Cp.EmptyToCollapsed}}">
            <StackPanel>
                <TextBlock Text="{Binding Heading}" Style="{StaticResource Cp.Eyebrow}" Foreground="{StaticResource Cp.TextMuted}"
                           Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Cp.NoteLine}" Focusable="False"/>
                <TextBlock Text="{Binding More}" Style="{StaticResource Cp.Hint}" Margin="16,2,0,0"
                           Visibility="{Binding More, Converter={StaticResource Cp.EmptyToCollapsed}}"/>
                <TextBlock Text="This update includes breaking changes — see the details before you race."
                           Style="{StaticResource Cp.Hint}" Foreground="{StaticResource Cp.Danger}" Margin="0,8,0,0"
                           Visibility="{Binding HasBreakingChanges, Converter={StaticResource Cp.BoolToVis}}"/>
            </StackPanel>
        </Border>

        <Border BorderBrush="{StaticResource Cp.Border}" BorderThickness="0,1,0,0" Background="{StaticResource Cp.Rail}"
                Padding="22,14" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Cp.Button}" Content="View details" Click="OnViewDetails"/>
                <Button Style="{StaticResource Cp.PrimaryButton}" Content="OK" MinWidth="84" Margin="8,0,0,0"
                        IsDefault="True" IsCancel="True" Click="OnOk"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
