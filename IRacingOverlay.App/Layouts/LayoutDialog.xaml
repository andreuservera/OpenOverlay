<Window x:Class="IRacingOverlay.App.Layouts.LayoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenOverlay"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Cp.Surface}" BorderBrush="{DynamicResource Cp.BorderStrong}" BorderThickness="1"
        FontFamily="{DynamicResource Theme.FontFamily}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        MouseLeftButtonDown="OnDrag">
    <!-- The layout screens' one small dialog: a question with a few answers, or a name to type.
         Answered with the mouse only — keyboard shortcuts are out of scope for layouts for now. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../ControlPanel/ControlPanelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>
        <StackPanel Margin="22,20,22,14">
            <TextBlock x:Name="Heading" Style="{StaticResource Cp.Title}" TextWrapping="Wrap"/>
            <TextBlock x:Name="Message" Style="{StaticResource Cp.Hint}" FontSize="{StaticResource Cp.Size.Body}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Border x:Name="InputFrame" Visibility="Collapsed" Margin="0,14,0,0" Height="32" Padding="10,0"
                    Background="{StaticResource Cp.Field}" BorderBrush="{StaticResource Cp.Border}"
                    BorderThickness="1" CornerRadius="6">
                <TextBox x:Name="Input" Style="{StaticResource Cp.TextBox}"
                         FontFamily="{DynamicResource Theme.FontFamily}" MaxLength="60"/>
            </Border>
        </StackPanel>

        <Border BorderBrush="{StaticResource Cp.Border}" BorderThickness="0,1,0,0" Background="{StaticResource Cp.Rail}"
                Padding="22,14">
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>
    </StackPanel>
</Window>
