<UserControl x:Class="IRacingOverlay.App.Overlay.ScalablePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <!-- The default WPF button chrome is a light-gray 3D bevel, which looks like a stray dialog
             control sitting on a dark overlay. Same size and behaviour, overlay-native finish. -->
        <Style x:Key="ZoomButton" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="#CC1C2026" BorderBrush="#5A6068" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Chip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E62E343C"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E6454C56"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="Transparent" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
        <ContentPresenter x:Name="InnerContent" Content="{Binding ScalableContent, ElementName=Root}">
            <ContentPresenter.LayoutTransform>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </ContentPresenter.LayoutTransform>
        </ContentPresenter>

        <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,4" Visibility="Collapsed">
            <Button x:Name="MinusButton" Content="−" Style="{StaticResource ZoomButton}"
                    Margin="0,0,4,0" Click="MinusButton_Click" ToolTip="Smaller text"/>
            <Button x:Name="PlusButton" Content="+" Style="{StaticResource ZoomButton}"
                    Click="PlusButton_Click" ToolTip="Bigger text"/>
        </StackPanel>
    </Grid>
</UserControl>
