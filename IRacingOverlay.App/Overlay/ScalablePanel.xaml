<UserControl x:Class="IRacingOverlay.App.Overlay.ScalablePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Background="Transparent" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
        <ContentPresenter x:Name="InnerContent" Content="{Binding ScalableContent, ElementName=Root}">
            <ContentPresenter.LayoutTransform>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </ContentPresenter.LayoutTransform>
        </ContentPresenter>

        <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,3" Visibility="Collapsed">
            <Button x:Name="MinusButton" Content="−" Width="18" Height="18" FontSize="11" Padding="0"
                    Margin="0,0,2,0" Click="MinusButton_Click" ToolTip="Smaller text"/>
            <Button x:Name="PlusButton" Content="+" Width="18" Height="18" FontSize="11" Padding="0"
                    Click="PlusButton_Click" ToolTip="Bigger text"/>
        </StackPanel>
    </Grid>
</UserControl>
