<UserControl x:Class="IRacingOverlay.App.Overlay.ScalablePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <!-- The default WPF button chrome is a light-gray 3D bevel, which looks like a stray dialog
             control sitting on a dark overlay. Same size and behaviour, overlay-native finish, with
             the hover wash easing in and out rather than snapping. -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{DynamicResource Theme.LabelFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush x:Name="ChromeFill" Color="#00FFFFFF"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ChromeFill" Storyboard.TargetProperty="Color"
                                                            To="#29FFFFFF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ChromeFill" Storyboard.TargetProperty="Color"
                                                            To="#00FFFFFF" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#47FFFFFF"/>
                            </Trigger>
                            <!-- At either end of the ladder the corresponding button stays in place but inert: the
                                 control never changes shape, and the greyed glyph says "end of the
                                 ladder" instead of leaving a press looking broken. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4A535D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScaleStepButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- The level readout doubles as the reset affordance: one click returns the panel to M. -->
        <Style x:Key="ScaleLevelChip" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource State.Accent}"/>
        </Style>
    </UserControl.Resources>

    <!-- Background="Transparent" so the panel's whole area (not just its painted pixels) raises the
         hover that reveals the size control. -->
    <Grid Background="Transparent" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave"
          PreviewMouseWheel="Root_PreviewMouseWheel">
        <!-- ContentHost carries the design size and the transform that scales it. The design size is
             bound to MinWidth/MinHeight rather than Width/Height on purpose: it guarantees a floor
             (a stretch-to-fill panel can't collapse to its caption) while still letting content that
             measures larger have the room it asks for, so this can never be what clips a panel.
             LayoutTransform — not RenderTransform — is what makes this control report the *scaled*
             size to its parent, which is the whole reason a SizeToContent widget window ends up
             exactly as big as its content at every level, never smaller. -->
        <ContentPresenter x:Name="ContentHost"
                          Content="{Binding ScalableContent, ElementName=Root}"
                          MinWidth="{Binding DesignWidth, ElementName=Root}"
                          MinHeight="{Binding DesignHeight, ElementName=Root}">
            <ContentPresenter.LayoutTransform>
                <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
            </ContentPresenter.LayoutTransform>
        </ContentPresenter>

        <!-- Floats over the top-right corner rather than taking part in layout: reserving a row for
             it would make every widget jump taller the moment the pointer touched it. Hover-only,
             and hit-testable only while shown, so it can never swallow a click meant for the widget
             (or for the game behind it). -->
        <Border x:Name="ScaleChrome" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                Background="#F2141920" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="13"
                Padding="3" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="MinusButton" Content="−" Style="{StaticResource ScaleStepButton}"
                        Click="MinusButton_Click" ToolTip="Smaller (Ctrl + wheel down)"/>
                <Button x:Name="LevelChip" Style="{StaticResource ScaleLevelChip}"
                        Click="LevelChip_Click" ToolTip="Reset to M"/>
                <Button x:Name="PlusButton" Content="+" Style="{StaticResource ScaleStepButton}"
                        Click="PlusButton_Click" ToolTip="Bigger (Ctrl + wheel up)"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
