<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:vm="clr-namespace:IRacingOverlay.App.ViewModels"
                    xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
                    xmlns:conv="clr-namespace:IRacingOverlay.App.Converters">
    <!--
      The column ruler and row rendering for both driver tables (Standings and Relative), declared
      once. Sharing this is what guarantees the two widgets stay identical: a width changed here
      moves the header and the data in both tables at the same time, and there is no second copy to
      forget.

      Bindings reach the panel's Options through RelativeSource rather than ElementName, since a
      shared dictionary has no element to name. The nearest UserControl ancestor of any row is
      always the panel hosting it, and both panels expose an Options property of the same type.
    -->

    <conv:ColumnVisibilityConverter x:Key="ColumnVisibilityConverter"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Column order and widths come from DriverTableOptions.Columns (DriverTableColumnLayout):
         header and rows bind each ColumnDefinition's width and each cell's Grid.Column to it, so a
         reordered or hidden column moves in both at once. -->
    <!-- Fastest lap of its class: a tinted chip in the purple the best-lap time already wears, with
         a stopwatch in the same ink — built like the pit and licence chips so it sits in the row
         rather than on top of it. The stopwatch is stroked on a 24-unit canvas and scaled whole. -->
    <SolidColorBrush x:Key="Badge.SpecialFill" Color="#2EB58CFF"/>
    <SolidColorBrush x:Key="Badge.SpecialEdge" Color="#B3B58CFF"/>
    <Style x:Key="FastestLapBadge" TargetType="Border">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Margin" Value="0,2,2,2"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Badge.SpecialEdge}"/>
        <Setter Property="Background" Value="{StaticResource Badge.SpecialFill}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="ToolTip" Value="Fastest lap in its class"/>
    </Style>

    <!-- The delta's segment inside the iRating badge: its column (44) minus the badge's inset.
         A string because it is fed to ColumnVisibilityConverter as the width to use when visible. -->
    <sys:String x:Key="W.IRatingDeltaSegment">36</sys:String>

    <!-- Header and data cells share one horizontal inset, which is what actually keeps the two
         grids in line. The left 8 leaves room for the class/player bar without any row's content
         shifting when it appears. Rows have a fixed height, so cells centre vertically instead of
         being padded into place. -->
    <Thickness x:Key="RulerInset">8,0,4,5</Thickness>
    <Thickness x:Key="CellInset">8,0,4,0</Thickness>
    <!-- Chips fill the row minus 2px top and bottom. -->
    <Thickness x:Key="ChipInset">0,2,6,2</Thickness>

    <!-- Every numeric column is right-aligned, header included, so digits line up vertically and
         can be compared down the table without reading them. -->
    <Style x:Key="HeadNumeric" TargetType="TextBlock" BasedOn="{StaticResource ColumnHeader}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="HeadText" TargetType="TextBlock" BasedOn="{StaticResource ColumnHeader}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="HeadCentered" TargetType="TextBlock" BasedOn="{StaticResource ColumnHeader}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <!-- Three tiers of ink on a row: primary (position, name, gap), secondary (lap times) and meta
         (iRating, lap count). The eye lands on the first tier and only reads the rest on purpose. -->
    <!-- The row's figures in the names' face and weight, so the line reads as one piece. -->
    <Style x:Key="NumCell" TargetType="TextBlock" BasedOn="{StaticResource DataCellNumeric}">
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource Theme.TableNumericFontFamily}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style x:Key="MetaCell" TargetType="TextBlock" BasedOn="{StaticResource NumCell}">
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
    </Style>
    <Style x:Key="PrimaryCell" TargetType="TextBlock" BasedOn="{StaticResource NumCell}">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
        <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
        <Setter Property="LineHeight" Value="{StaticResource Line.Body}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Theme.NumericFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- Same plate as the car-number chip, so every badge on the row belongs to one family. -->
    <Style x:Key="RatingBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface.Chip}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Surface.ChipBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}"/>
        <Setter Property="Margin" Value="{StaticResource ChipInset}"/>
    </Style>
    <!-- iRating trend: a filled chevron (^ / v), centred in the 7 x 9 box. -->
    <Geometry x:Key="Geometry.ArrowUp">M0,5.3 L3.5,1.8 L7,5.3 L7,7.5 L3.5,4 L0,7.5 Z</Geometry>
    <Geometry x:Key="Geometry.ArrowDown">M0,3.7 L3.5,7.2 L7,3.7 L7,1.5 L3.5,5 L0,1.5 Z</Geometry>
    <Style x:Key="TrendArrow" TargetType="Path">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Last pit stop: the PIT tag's tinted amber and orange edge, so the two read as one family,
         split into lap | time segments. -->
    <Style x:Key="PitStopChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Badge.WarningFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Badge.WarningEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}"/>
        <Setter Property="Margin" Value="{StaticResource ChipInset}"/>
    </Style>
    <!-- The car-number chip's text exactly (face, size, line box), so the lap and time sit centred
         in the chip the same way the number does. -->
    <Style x:Key="PitStopText" TargetType="TextBlock" BasedOn="{StaticResource ChipText}"/>

    <!-- Same height as a data row, so a reserved slot holds its place without the table visibly
         stuttering as cars move in and out of it. -->
    <DataTemplate DataType="{x:Type vm:RelativePlaceholderRow}">
        <Border Height="{StaticResource Size.Row}" Margin="0,1" Background="{StaticResource Row.Placeholder}"
                CornerRadius="{StaticResource Radius.Row}"/>
    </DataTemplate>

    <!-- Declared against the base row type: WPF's implicit template lookup walks up the type
         hierarchy, so this one template renders both StandingsRow and RelativeRow. The GAP column
         is the only thing the two disagree on, and each supplies its own GapDisplay. -->
    <DataTemplate DataType="{x:Type vm:DriverRow}">
        <!-- Layers rather than nested borders, so nothing a state adds (outline, bar) can push the
             cells sideways: every row's columns sit at the same x whatever the row's state. -->
        <Border Height="{StaticResource Size.Row}" Margin="0,1">
            <Grid>
                <Border x:Name="Band" Background="{StaticResource Row.Base}" CornerRadius="{StaticResource Radius.Row}"/>
                <!-- Multiclass: the class bar bleeds into the row as a wash that has dissolved into
                     the panel by the time it reaches the timing columns. Recognisable at a glance,
                     never louder than the data on top of it. -->
                <Border x:Name="ClassWash" CornerRadius="{StaticResource Radius.Row}" Visibility="Collapsed"
                        Background="{Binding ClassColor, Mode=OneTime, Converter={StaticResource ClassGradientConverter}, ConverterParameter=0.22}"/>
                <Border x:Name="Outline" CornerRadius="{StaticResource Radius.Row}" BorderThickness="1"/>
                <Border x:Name="EdgeBar" Width="3" HorizontalAlignment="Left" CornerRadius="{StaticResource Radius.RowEdge}"/>
                <Grid x:Name="Cells" Margin="{StaticResource CellInset}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Options.Columns.Width0, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width1, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width2, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width3, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width4, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width5, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width6, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width7, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width8, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width9, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width10, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width11, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width12, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <ColumnDefinition Width="{Binding Options.Columns.Width13, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <!-- Not a column: the fastest-lap mark's slot, always last. -->
                        <ColumnDefinition Width="{Binding Options.FastestLapMarkWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="14"
                          Visibility="{Binding Options.ShowFastestLapMark, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource FastestLapBadge}"
                                Visibility="{Binding IsSessionFastestLap, Mode=OneTime, Converter={StaticResource BoolToVis}}">
                            <Viewbox Margin="2">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{StaticResource State.Special}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M12,6 A8,8 0 1 1 11.99,6 Z M9.5,2.5 L14.5,2.5 M12,2.5 L12,6 M18.6,6.4 L20.2,4.8 M12,14 L12,10"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Column="{Binding Options.Columns.Position, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding PositionDisplay, Mode=OneTime}" Style="{StaticResource PrimaryCell}"
                               Foreground="{Binding PositionForeground, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}"
                               Visibility="{Binding Options.ShowPosition, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}"/>

                    <!-- Neutral plate: the class is already on the row's edge, so a filled chip in the
                         class colour would only repeat it at full volume. -->
                    <Border x:Name="CarChip" Grid.Column="{Binding Options.Columns.CarNumber, RelativeSource={RelativeSource AncestorType=UserControl}}" Background="{StaticResource Surface.Chip}" BorderBrush="{StaticResource Surface.ChipBorder}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Chip}" Margin="{StaticResource ChipInset}"
                            Visibility="{Binding Options.ShowCarNumber, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}">
                        <TextBlock Text="{Binding CarNumberDisplay, Mode=OneTime}" Style="{StaticResource ChipText}"/>
                    </Border>

                    <!-- The make: its logo in the secondary ink, or a monogram where the logo can't be
                         read. Cars of no make the app knows (spec and dirt cars) get iRacing's emblem. -->
                    <w:CarBrandIcon Grid.Column="{Binding Options.Columns.CarBrand, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="24" Height="16" HorizontalAlignment="Center" Margin="0,0,4,0"
                                    Logo="{Binding CarBrandLogo, Mode=OneTime}" Monogram="{Binding CarBrandMonogram, Mode=OneTime}"
                                    Visibility="{Binding Options.ShowCarBrand, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}"/>

                    <!-- The driver's flag, from their iRacing flair. Blank for no flair, "Global", or a
                         country there's no flag for. -->
                    <w:CountryFlagIcon Grid.Column="{Binding Options.Columns.CountryFlag, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="22" Height="15" HorizontalAlignment="Center" Margin="0,0,4,0"
                                       Country="{Binding FlairName, Mode=OneTime}"
                                       Visibility="{Binding Options.ShowCountryFlag, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}"/>

                    <!-- Status badges take their room out of the name, never out of another column. -->
                    <DockPanel Grid.Column="{Binding Options.Columns.Driver, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,8,0"
                               Visibility="{Binding Options.ShowDriver, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadge}"
                                Visibility="{Binding OnPitRoad, Mode=OneTime, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="PIT" Style="{StaticResource StatusBadgeText}"/>
                        </Border>
                        <!-- One penalty flag slot, same footprint in every state: black, furled black or
                             meatball, or the two most serious side by side. -->
                        <w:PenaltyFlagTag DockPanel.Dock="Right" Width="24" Height="15" Margin="6,0,0,0" VerticalAlignment="Center"
                                          Primary="{Binding PrimaryPenalty, Mode=OneTime}" Secondary="{Binding SecondaryPenalty, Mode=OneTime}"
                                          Visibility="{Binding HasPenaltyFlag, Mode=OneTime, Converter={StaticResource BoolToVis}}"/>
                        <!-- Two pixels over the body size on the same line box: mixed-case names need
                             the extra x-height to read as quickly as the old all-caps ones. -->
                        <TextBlock x:Name="NameText" Text="{Binding NameDisplay, Mode=OneTime}" Style="{StaticResource DataCell}"
                                   FontFamily="{DynamicResource Theme.NameFontFamily}" FontSize="16" FontWeight="Medium"
                                   Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Independent of the PIT badge: appears after the first completed stop and
                         stays, so both can show at once while the car is back in the lane. -->
                    <Grid Grid.Column="{Binding Options.Columns.LastPitStop, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Visibility="{Binding Options.ShowLastPitStop, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}">
                        <Border Style="{StaticResource PitStopChip}"
                                Visibility="{Binding HasLastPitStop, Mode=OneTime, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding LastPitLapDisplay, Mode=OneTime}" Style="{StaticResource PitStopText}"
                                           Margin="5,0" Foreground="{StaticResource State.Warning}"/>
                                <Border Grid.Column="1" Background="{StaticResource Badge.WarningEdge}" Margin="0,3"/>
                                <TextBlock Grid.Column="2" Text="{Binding LastPitDurationDisplay, Mode=OneTime}" Style="{StaticResource PitStopText}"
                                           Foreground="#F2E3C6"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- The tyre: dark rubber, the compound's broadcast colour as a sidewall stripe and
                         its letter in the middle. Blank when the sim doesn't say. -->
                    <Grid Grid.Column="{Binding Options.Columns.TireCompound, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="17" Height="17" HorizontalAlignment="Center" Margin="0,0,4,0"
                          Visibility="{Binding Options.ShowTireCompound, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}">
                        <w:TireCompoundIcon Letter="{Binding TireCompoundLetter, Mode=OneTime}" Ink="{Binding TireCompoundColor, Mode=OneTime}"
                                            Visibility="{Binding HasTireCompound, Mode=OneTime, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- iRating badge: spans the iR and iRΔ columns, so hiding the delta hands its
                         width back exactly as the separate column used to. The delta is a tinted
                         segment on the right carrying an arrow and the magnitude. -->
                    <Border x:Name="RatingBadge" Grid.Column="{Binding Options.Columns.IRating, RelativeSource={RelativeSource AncestorType=UserControl}}" Grid.ColumnSpan="2" Style="{StaticResource RatingBadge}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{Binding Options.ShowIRatingDelta, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter={StaticResource W.IRatingDeltaSegment}}"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding IRatingDisplay, Mode=OneTime}" Style="{StaticResource ChipText}"
                                       Visibility="{Binding Options.ShowIRating, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}"/>
                            <Border Grid.Column="1" CornerRadius="0,2,2,0"
                                    Background="{Binding IRatingDeltaForeground, Mode=OneTime, Converter={StaticResource ColorAlphaConverter}, ConverterParameter=0.16}"
                                    Visibility="{Binding Options.ShowIRatingDelta, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path x:Name="TrendArrow" Style="{StaticResource TrendArrow}" Data="{StaticResource Geometry.ArrowUp}"
                                          Fill="{Binding IRatingDeltaForeground, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}"/>
                                    <TextBlock Text="{Binding IRatingDeltaDisplay, Mode=OneTime}" Style="{StaticResource ChipText}"
                                               FontSize="{StaticResource Type.Label}" LineHeight="{StaticResource Line.Label}"
                                               Foreground="{Binding IRatingDeltaForeground, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Tinted, outlined chip: the licence colour still says R/D/C/B/A at a glance, but
                         as a tint it no longer out-shouts the driver's name next to it. -->
                    <Border Grid.Column="{Binding Options.Columns.License, RelativeSource={RelativeSource AncestorType=UserControl}}" CornerRadius="{StaticResource Radius.Chip}" Margin="{StaticResource ChipInset}" BorderThickness="1"
                            Background="{Binding LicenseColor, Mode=OneTime, Converter={StaticResource ColorAlphaConverter}, ConverterParameter=0.24}"
                            BorderBrush="{Binding LicenseColor, Mode=OneTime, Converter={StaticResource ColorAlphaConverter}, ConverterParameter=0.75}"
                            Visibility="{Binding Options.ShowLicense, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}">
                        <TextBlock Text="{Binding LicStringDisplay, Mode=OneTime}" Style="{StaticResource ChipText}"
                                   FontSize="{StaticResource Type.Micro}" LineHeight="{StaticResource Line.Micro}"/>
                    </Border>

                    <TextBlock Grid.Column="{Binding Options.Columns.Lap, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding LapDisplay, Mode=OneTime}" Style="{StaticResource MetaCell}"
                               Visibility="{Binding Options.ShowLap, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}"/>

                    <TextBlock Grid.Column="{Binding Options.Columns.BestLap, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding BestLapDisplay, Mode=OneTime}" Style="{StaticResource NumCell}"
                               Foreground="{Binding BestLapForeground, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}"
                               Visibility="{Binding Options.ShowBestLap, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}"/>

                    <TextBlock Grid.Column="{Binding Options.Columns.LastLap, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding LastLapDisplay, Mode=OneTime}" Style="{StaticResource NumCell}"
                               Foreground="{Binding LastLapForeground, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}"
                               Visibility="{Binding Options.ShowLastLap, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}"/>

                    <TextBlock x:Name="GapText" Grid.Column="{Binding Options.Columns.Gap, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding GapDisplay, Mode=OneTime}" Style="{StaticResource PrimaryCell}"
                               Foreground="{Binding GapForeground, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}"
                               Visibility="{Binding Options.ShowGap, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColumnVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMultiClass, Mode=OneTime}" Value="True">
                <Setter TargetName="ClassWash" Property="Visibility" Value="Visible"/>
                <Setter TargetName="EdgeBar" Property="Background" Value="{Binding ClassColor, Mode=OneTime, Converter={StaticResource CachedBrushConverter}}"/>
            </DataTrigger>
            <!-- In the pits: not racing anyone this instant, so the whole row steps back. -->
            <DataTrigger Binding="{Binding OnPitRoad, Mode=OneTime}" Value="True">
                <Setter TargetName="Band" Property="Background" Value="{StaticResource Row.Pit}"/>
                <Setter TargetName="Cells" Property="Opacity" Value="{StaticResource Row.PitOpacity}"/>
            </DataTrigger>
            <!-- Lap traffic, in iRacing's colours as ink on the name and gap only — never a fill that
                 could read as a class: blue a lap or more down, red a lap or more up. Always at full
                 strength, so the blue reads as clearly as the red and as every other row's ink. -->
            <DataTrigger Binding="{Binding LapRelation, Mode=OneTime}" Value="{x:Static vm:LapRelation.Lapped}">
                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Row.LappedInk}"/>
                <Setter TargetName="GapText" Property="Foreground" Value="{StaticResource Row.LappedInk}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding LapRelation, Mode=OneTime}" Value="{x:Static vm:LapRelation.BeingLapped}">
                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Row.LappedInk}"/>
                <Setter TargetName="GapText" Property="Foreground" Value="{StaticResource Row.LappedInk}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding LapRelation, Mode=OneTime}" Value="{x:Static vm:LapRelation.Lapping}">
                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Row.LappingInk}"/>
                <Setter TargetName="GapText" Property="Foreground" Value="{StaticResource Row.LappingInk}"/>
            </DataTrigger>
            <!-- Declared after the others so it wins: the player's row is always full strength, even
                 in the pits. Neutral white rather than any hue, so it can't be mistaken for a class:
                 a lighter band, a white outline and a bold name. The class bar stays in multiclass. -->
            <DataTrigger Binding="{Binding IsPlayer, Mode=OneTime}" Value="True">
                <Setter TargetName="Band" Property="Background" Value="{StaticResource Row.Player}"/>
                <Setter TargetName="ClassWash" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Row.PlayerOutline}"/>
                <Setter TargetName="Cells" Property="Opacity" Value="1"/>
                <Setter TargetName="NameText" Property="FontWeight" Value="Bold"/>
                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Row.PlayerInk}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPlayer, Mode=OneTime}" Value="True"/>
                    <Condition Binding="{Binding IsMultiClass, Mode=OneTime}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="EdgeBar" Property="Background" Value="{StaticResource Row.PlayerOutline}"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IRatingTrend, Mode=OneTime}" Value="-1">
                <Setter TargetName="TrendArrow" Property="Data" Value="{StaticResource Geometry.ArrowDown}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IRatingTrend, Mode=OneTime}" Value="0">
                <Setter TargetName="TrendArrow" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Options.ShowIRating, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                    <Condition Binding="{Binding Options.ShowIRatingDelta, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="RatingBadge" Property="Visibility" Value="Collapsed"/>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
