<Window x:Class="IRacingOverlay.App.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
        xmlns:ov="clr-namespace:IRacingOverlay.App.Overlay"
        Title="OpenOverlay Dashboard"
        Icon="/Assets/icon.ico"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="70"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Track map: the one element that spans the *entire* screen width (over both proximity
             bar columns too), pinned at the very top — every other panel lives inside the center
             column only. Left stretched rather than given a design width: under a LayoutTransform a
             stretched child is measured against the inverse-scaled slot, so the bar keeps filling
             the screen at every level and only its contents grow. -->
        <ov:ScalablePanel x:Name="TrackMapScaler" PersistenceKey="Dashboard.TrackMap"
                          Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Margin="0,0,0,14">
            <w:TrackMapPanel/>
        </ov:ScalablePanel>

        <!-- Center: tire info TR, flag+fuel+incidents BL, pedal trace BR, around the biggest
             elements — standings/relative in the middle, gear/delta bottom-center. Every panel is
             wrapped in ScalablePanel so its +/- control resizes it independently of the others
             (dashboard panels have no edit-mode/click-through concept, so the control is always
             reachable — it still only appears on hover). -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Track info: full-width horizontal bar across the very top center, above everything
                 else — the one piece of context (track, weather, session clock) that applies to the
                 whole screen rather than any particular corner. -->
            <ov:ScalablePanel x:Name="TrackInfoScaler" PersistenceKey="Dashboard.TrackInfo"
                              Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,14">
                <w:TrackInfoPanel/>
            </ov:ScalablePanel>

            <!-- Standings spans both row 1 and row 2 (TireInfo's row plus the * row) so its left
                 column — nothing else lives there any more now that Fuel/Incident moved to the
                 bottom-left corner — stretches all the way up to TrackInfo's bottom edge instead of
                 stopping at the top of the * row. TireInfo/Relative stay confined to their own
                 right-hand column, stacked (TireInfo above Relative) so they don't collide with each
                 other now that TireInfo no longer has its own separate full-width row. -->
            <Grid Grid.Row="1" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto" MinWidth="360"/>
                </Grid.ColumnDefinitions>
                <ov:ScalablePanel x:Name="StandingsScaler" PersistenceKey="Dashboard.Standings" Grid.Column="0">
                    <w:StandingsPanel/>
                </ov:ScalablePanel>
                <!-- Grid instead of StackPanel: TireInfo takes its own natural (Auto) height, and
                     Relative fills the rest (*), so its bottom edge lines up with Standings' bottom
                     edge — both stretch to the same RowSpan="2" bottom, just Standings owns the whole
                     left column while TireInfo+Relative share this right column. -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ov:ScalablePanel x:Name="TireInfoScaler" PersistenceKey="Dashboard.TireInfo" DesignWidth="300"
                                      Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,12">
                        <w:TireInfoPanel/>
                    </ov:ScalablePanel>
                    <ov:ScalablePanel x:Name="RelativeScaler" PersistenceKey="Dashboard.Relative" Grid.Row="1">
                        <w:RelativePanel/>
                    </ov:ScalablePanel>
                </Grid>
            </Grid>

            <ov:ScalablePanel x:Name="DeltaScaler" PersistenceKey="Dashboard.Delta" DesignWidth="260"
                              Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <w:DeltaPanel/>
            </ov:ScalablePanel>

            <!-- Cockpit cluster (speed/gear/RPM/ABS/proximity, all in one bezel): lower-center,
                 closer to eye level since a second monitor is typically mounted above the main one.
                 Same CockpitPanel the floating widget uses, at the same 310x150 design size, so both
                 stay visually identical by construction rather than by keeping two hand-written
                 layouts in sync. 310x150 is CockpitPanel's own measured natural size (tightly-fit
                 fixed-width columns inside, no padded-out star ratios) — that's what eliminated the
                 dead space between speed/gear/RPM. -->
            <ov:ScalablePanel x:Name="CockpitScaler" PersistenceKey="Dashboard.Cockpit" DesignWidth="310" DesignHeight="150"
                              Grid.Row="4" HorizontalAlignment="Center" Margin="0,14,0,0">
                <w:CockpitPanel/>
            </ov:ScalablePanel>

            <!-- Bottom-left corner: flag (enlarged, FlagPanel's own box size grew, so it reads at a
                 glance) with fuel/incidents stacked beside it — moved down here from the top-left so
                 that row, previously the tallest thing sharing row 1 with tire info, no longer forces
                 that Auto row to be as tall, leaving more of the * row underneath for
                 Standings/Relative to stretch into. Spans all rows so it can anchor to the true
                 bottom-left of the center area. -->
            <StackPanel Grid.Row="1" Grid.RowSpan="4" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <ov:ScalablePanel x:Name="FlagScaler" PersistenceKey="Dashboard.Flag" DesignWidth="280">
                    <w:FlagPanel/>
                </ov:ScalablePanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Margin="12,0,0,0">
                    <ov:ScalablePanel x:Name="FuelScaler" PersistenceKey="Dashboard.Fuel" DesignWidth="320" Margin="0,0,0,10">
                        <w:FuelPanel/>
                    </ov:ScalablePanel>
                    <ov:ScalablePanel x:Name="IncidentScaler" PersistenceKey="Dashboard.Incident" DesignWidth="320">
                        <w:IncidentPanel/>
                    </ov:ScalablePanel>
                </StackPanel>
            </StackPanel>

            <!-- Pedal trace: bottom-right corner, mirroring the flag's bottom-left placement so the
                 four corners stay visually balanced. -->
            <ov:ScalablePanel x:Name="PedalTraceScaler" PersistenceKey="Dashboard.PedalTrace" DesignWidth="340" DesignHeight="180"
                              Grid.Row="3" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <w:PedalTracePanel/>
            </ov:ScalablePanel>
        </Grid>

    </Grid>
</Window>
