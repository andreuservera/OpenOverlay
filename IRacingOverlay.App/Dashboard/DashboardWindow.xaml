<Window x:Class="IRacingOverlay.App.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:IRacingOverlay.App.Widgets"
        Title="iRacing Overlay Dashboard"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="Black"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="70"/>
        </Grid.ColumnDefinitions>

        <!-- Left proximity: full-height vertical bar on the left edge -->
        <w:ProximityBarPanel x:Name="LeftProximity" Grid.Column="0" Margin="0,0,8,0"/>

        <!-- Center: tire info corner, standings/relative, delta + gear/shift lights, flag corner -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="90"/>
                <RowDefinition Height="280"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <w:TireInfoPanel x:Name="TireInfo" HorizontalAlignment="Right" VerticalAlignment="Top" Width="300"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <w:StandingsPanel x:Name="Standings" Grid.Column="0"/>
                <w:RelativePanel x:Name="Relative" Grid.Column="2"/>
            </Grid>

            <w:DeltaPanel x:Name="Delta" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="260"/>

            <!-- Gear/shift lights: lower-center, closer to eye level since a second monitor is
                 typically mounted above the main one. Scaled up via Viewbox since ShiftGearPanel is
                 sized for a small floating widget, not a full monitor. -->
            <Border Grid.Row="3" Background="#E6141414" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6"
                    HorizontalAlignment="Center" Width="420" Height="260" Margin="0,10,0,0">
                <Viewbox Stretch="Uniform" Margin="16">
                    <w:ShiftGearPanel x:Name="ShiftGear"/>
                </Viewbox>
            </Border>

            <!-- Flag: bottom-left corner, enlarged (FlagPanel's own box size grew) so it reads at a
                 glance — spans all rows so it can anchor to the true bottom-left of the center area. -->
            <w:FlagPanel x:Name="Flag" Grid.RowSpan="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="280"/>
        </Grid>

        <!-- ABS + right proximity: full-height vertical bars on the right edge -->
        <w:GlowBarPanel x:Name="AbsBar" Grid.Column="2" Margin="8,0,0,0"/>
        <w:ProximityBarPanel x:Name="RightProximity" Grid.Column="3" Margin="8,0,0,0"/>
    </Grid>
</Window>
