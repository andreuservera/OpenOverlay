<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IRacingOverlay.Sdk\IRacingOverlay.Sdk.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- AssemblyName is independent of the project file name / root namespace above — this is the
         branding name users see (exe file name, taskbar, Explorer), while the project and all C#
         namespaces stay IRacingOverlay.* internally. -->
    <AssemblyName>OpenOverlay</AssemblyName>
    <Product>OpenOverlay</Product>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <!--
    UseWindowsForms injects a global "using System.Windows.Forms;" which collides with WPF's
    System.Windows namespace (Application, UserControl, etc. exist in both). We only need WinForms
    for Screen/monitor enumeration, referenced via an explicit alias where needed, so drop the
    blanket implicit using rather than aliasing every ambiguous type across the project.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IRacingOverlay.App.Tests" />
  </ItemGroup>

</Project>
