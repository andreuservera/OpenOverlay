<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IRacingOverlay.Sdk\IRacingOverlay.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- AssemblyName is independent of the project file name / root namespace above — this is the
         branding name users see (exe file name, taskbar, Explorer), while the project and all C#
         namespaces stay IRacingOverlay.* internally. -->
    <AssemblyName>OpenOverlay</AssemblyName>
    <Product>OpenOverlay</Product>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Velopack needs a custom Main (below, in App.xaml.cs) instead of WPF's own generated one, so
         it can call VelopackApp.Build().Run() — which handles first-run install hooks and applying
         pending updates — before any WPF/Application machinery spins up. -->
    <StartupObject>IRacingOverlay.App.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <!-- Backdrop the control panel previews widgets against. Embedded rather than shipped loose so
         it can't go missing from an install and leave the preview pane empty. -->
    <Resource Include="Assets\spa2.jpg" />
    <!-- Must not be an ApplicationDefinition (which auto-generates its own Main) now that
         App.xaml.cs provides one explicitly for Velopack's sake. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!--
    UseWindowsForms injects a global "using System.Windows.Forms;" which collides with WPF's
    System.Windows namespace (Application, UserControl, etc. exist in both). We only need WinForms
    for Screen/monitor enumeration, referenced via an explicit alias where needed, so drop the
    blanket implicit using rather than aliasing every ambiguous type across the project.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IRacingOverlay.App.Tests" />
  </ItemGroup>

  <!-- CHANGELOG.md is the single source of truth: its first "[X.Y.Z]" heading is this build's
       version, and the file is embedded for What's New and the Changelog page. -->
  <PropertyGroup>
    <ChangelogPath>$(MSBuildThisFileDirectory)..\CHANGELOG.md</ChangelogPath>
    <_ChangelogHeading>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ChangelogPath)')), '(?m)^#{2,3}[ \t]+\[?v?\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?').Value)</_ChangelogHeading>
    <ChangelogVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_ChangelogHeading)', '^#{2,3}[ \t]+\[?v?', ''))</ChangelogVersion>
    <Version>$(ChangelogVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ChangelogPath)" LogicalName="OpenOverlay.CHANGELOG.md" Link="CHANGELOG.md" />
  </ItemGroup>

  <Target Name="RequireChangelogVersion" BeforeTargets="BeforeBuild" Condition="'$(ChangelogVersion)' == ''">
    <Error Text="CHANGELOG.md needs a version heading such as '### [1.2.3] - 2026-10-01' above the older ones." />
  </Target>

</Project>
