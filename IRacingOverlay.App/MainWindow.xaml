<Window x:Class="IRacingOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iRacing Overlay — Control Panel" Height="470" Width="460"
        Background="#1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Red" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText" Text="Waiting for iRacing…" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="RelativeCheckBox" Content="Relative widget" Foreground="White" Margin="0,0,16,0"
                      Checked="RelativeCheckBox_Changed" Unchecked="RelativeCheckBox_Changed"/>
            <CheckBox x:Name="StandingsCheckBox" Content="Standings widget" Foreground="White" Margin="0,0,16,0"
                      Checked="StandingsCheckBox_Changed" Unchecked="StandingsCheckBox_Changed"/>
            <CheckBox x:Name="CockpitCheckBox" Content="Cockpit widget" Foreground="White"
                      Checked="CockpitCheckBox_Changed" Unchecked="CockpitCheckBox_Changed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="FlagCheckBox" Content="Flag widget" Foreground="White" Margin="0,0,16,0"
                      Checked="FlagCheckBox_Changed" Unchecked="FlagCheckBox_Changed"/>
            <CheckBox x:Name="TireInfoCheckBox" Content="Tire info widget" Foreground="White" Margin="0,0,16,0"
                      Checked="TireInfoCheckBox_Changed" Unchecked="TireInfoCheckBox_Changed"/>
            <CheckBox x:Name="DeltaCheckBox" Content="Delta widget" Foreground="White"
                      Checked="DeltaCheckBox_Changed" Unchecked="DeltaCheckBox_Changed"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Delta reference:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="DeltaReferenceComboBox" Width="180" SelectionChanged="DeltaReferenceComboBox_SelectionChanged">
                <ComboBoxItem Content="Session best lap" IsSelected="True"/>
                <ComboBoxItem Content="Personal best (all-time)"/>
                <ComboBoxItem Content="Optimal lap"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="EditModeCheckBox" Content="Edit layout (drag/resize widgets)" Foreground="White"
                      Checked="EditModeCheckBox_Changed" Unchecked="EditModeCheckBox_Changed"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Dashboard monitor:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="MonitorComboBox" Width="180" Margin="0,0,8,0"/>
            <Button x:Name="ShowDashboardButton" Content="Show dashboard" Click="ShowDashboardButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,8">
            <TextBlock x:Name="DebugText" Text="Speed: —   Lap: —   Gear: —" Foreground="#AAAAAA" FontFamily="Consolas" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
