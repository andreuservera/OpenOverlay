<Window x:Class="IRacingOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IRacingOverlay.App.Localization"
        xmlns:cp="clr-namespace:IRacingOverlay.App.ControlPanel"
        Title="{loc:T main.openoverlayControlPanel}"
        Height="880" Width="1400" MinHeight="620" MinWidth="1080"
        Icon="Assets/icon.ico"
        Background="{DynamicResource Cp.Window}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <!--
      Three panes, left to right, in the order the decision is actually made:

        pick a widget  ->  change its options  ->  see the result

      The rail is the only navigation; the configuration pane shows one widget at a time and nothing
      else; the preview is always visible, so no change is ever made blind. Only the two panes that
      can genuinely overflow scroll, so the shell itself never moves under the pointer.

      The control panel's design system lives in ControlPanel/ControlPanelTheme.xaml and is merged
      here rather than into App.xaml on purpose: the preview hosts real widget panels, and an
      application-wide style from this window would restyle them — the one thing that would make the
      preview lie about what the user is going to get.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ControlPanel/ControlPanelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- General › Window › Interface size: the whole window, scaled as one. -->
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding InterfaceScale}" ScaleY="{Binding InterfaceScale}"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0" Height="58" Background="{StaticResource Cp.Rail}"
                BorderBrush="{StaticResource Cp.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="OpenOverlay" Style="{StaticResource Cp.Title}" Margin="11,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Connection to the sim, as a pill whose colour is the state: green connected (with
                     the track and session), amber waiting or degraded, red when something is wrong.
                     The colour never stands alone: the pill says it in words, and while waiting the
                     line beside it says what to do. -->
                <DockPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center" LastChildFill="True">
                    <Border DockPanel.Dock="Left" CornerRadius="13" Height="26" Padding="10,0,12,0" BorderThickness="1"
                            ToolTip="{loc:T main.connectionToTheIracing}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Cp.WarningWash}"/>
                                <Setter Property="BorderBrush" Value="#66F5A524"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionTone}" Value="Live">
                                        <Setter Property="Background" Value="{StaticResource Cp.LiveWash}"/>
                                        <Setter Property="BorderBrush" Value="#663DD68C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionTone}" Value="Error">
                                        <Setter Property="Background" Value="{StaticResource Cp.DangerWash}"/>
                                        <Setter Property="BorderBrush" Value="#66F26D6D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Cp.Warning}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionTone}" Value="Live">
                                                <Setter Property="Fill" Value="{StaticResource Cp.Live}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionTone}" Value="Error">
                                                <Setter Property="Fill" Value="{StaticResource Cp.Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionLabel}" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="{StaticResource Cp.Size.Small}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Cp.Warning}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionTone}" Value="Live">
                                                <Setter Property="Foreground" Value="{StaticResource Cp.Live}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionTone}" Value="Error">
                                                <Setter Property="Foreground" Value="{StaticResource Cp.Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ConnectionHint}" Style="{StaticResource Cp.Hint}" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ConnectionHint}"/>
                </DockPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Layouts at hand: pick one and switch it on; while one is open, picking another
                         switches to it. Lit in the accent colour while a layout is open. -->
                    <Border CornerRadius="6" Height="32" Padding="12,0,3,0" BorderThickness="1"
                            Visibility="{Binding HasLayouts, Converter={StaticResource Cp.BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Cp.SurfaceAlt}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Cp.Border}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOpenLayout}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Cp.AccentWash}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Cp.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T main.layout}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Cp.Eyebrow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOpenLayout}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Cp.Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox Style="{StaticResource Cp.ComboBox}" Height="24" MinWidth="160" MaxWidth="240"
                                      ItemsSource="{Binding LayoutChoices}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding ToolbarLayout, Mode=TwoWay}"
                                      ToolTip="{loc:T main.pickALayoutWhile}"/>
                            <Button Width="24" Height="24" Margin="6,0,0,0" Cursor="Hand" Focusable="False"
                                    Command="{Binding ToggleLayoutCommand}" ToolTip="{Binding LayoutToggleTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Disc" CornerRadius="4" Background="{StaticResource Cp.Field}"
                                                BorderBrush="{StaticResource Cp.Border}" BorderThickness="1">
                                            <!-- Drawn in its 24×24 icon frame and scaled by the Viewbox: a Path with
                                                 Stretch="Uniform" lands a pixel off-centre (measured on a render).
                                                 Moved down 0.95 so its ink, not its frame, is centred vertically. -->
                                            <Viewbox Width="12" Height="12">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="Icon" Canvas.Top="0.95" Data="M12,3 V11 M6.6,6.4 A7.5,7.5 0 1 0 17.4,6.4"
                                                          Stroke="{StaticResource Cp.TextMuted}"
                                                          StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Disc" Property="BorderBrush" Value="{StaticResource Cp.BorderStrong}"/>
                                                <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource Cp.Text}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding HasOpenLayout}" Value="True">
                                                <Setter TargetName="Disc" Property="Background" Value="{StaticResource Cp.Accent}"/>
                                                <Setter TargetName="Disc" Property="BorderBrush" Value="{StaticResource Cp.Accent}"/>
                                                <Setter TargetName="Icon" Property="Stroke" Value="#101316"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Cp.Button}" Content="{loc:T main.noLayoutsYet}"
                            Command="{Binding GoToLayoutsCommand}"
                            Visibility="{Binding HasLayouts, Converter={StaticResource Cp.NotBoolToVis}}"
                            ToolTip="{loc:T main.createALayoutOn}"/>

                    <Border Width="1" Height="16" Background="{StaticResource Cp.Border}" Margin="12,0"/>
                    <ToggleButton Style="{StaticResource Cp.MoveToggle}" Content="{Binding EditModeLabel}"
                                  IsChecked="{Binding IsEditMode, Mode=TwoWay}"
                                  ToolTip="{loc:T main.dragWidgetsIntoPlace}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Settings and preview split 40/60 by default; where the splitter is left is
                     remembered (PaneSplitStore), as a share so it holds on any window width. -->
                <ColumnDefinition x:Name="ConfigColumn" Width="0.4*" MinWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0.6*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Rail ===== -->
            <!-- Folds to its icons (IsRailCollapsed): names, switches and headings go, the icons
                 stay in place and say their name on hover. -->
            <Border Grid.Column="0" Background="{StaticResource Cp.Rail}"
                    BorderBrush="{StaticResource Cp.Border}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="278"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRailCollapsed}" Value="True">
                                <Setter Property="Width" Value="62"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <!-- Folded: the button that unfolds it, and search, which unfolds it to type. -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,14,0,2"
                                Visibility="{Binding IsRailCollapsed, Converter={StaticResource Cp.BoolToVis}}">
                        <Button Style="{StaticResource Cp.StepButton}" Width="32" Height="32" HorizontalAlignment="Center"
                                Command="{Binding ToggleRailCommand}" ToolTip="{loc:T main.showTheSidebarS}">
                            <Path Data="{StaticResource Cp.Icon.Sidebar}" Style="{StaticResource Cp.RailToggleIcon}"/>
                        </Button>
                        <Button Style="{StaticResource Cp.StepButton}" Width="32" Height="32" HorizontalAlignment="Center"
                                Margin="0,4,0,0" Click="RailSearch_Click" ToolTip="{loc:T main.searchSettings}">
                            <Path Data="{StaticResource Cp.Icon.Search}" Style="{StaticResource Cp.RailToggleIcon}"/>
                        </Button>
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Top" Margin="14,14,10,2"
                               Visibility="{Binding IsRailCollapsed, Converter={StaticResource Cp.NotBoolToVis}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Cp.StepButton}" Width="30" Height="32" Margin="6,0,0,0"
                            Command="{Binding ToggleRailCommand}" ToolTip="{loc:T main.foldTheSidebarTo}">
                        <Path Data="{StaticResource Cp.Icon.Sidebar}" Style="{StaticResource Cp.RailToggleIcon}"/>
                    </Button>
                    <Border Height="32" CornerRadius="7"
                            Background="{StaticResource Cp.Field}" BorderBrush="{StaticResource Cp.Border}"
                            BorderThickness="1">
                        <Grid>
                            <Path Data="{StaticResource Cp.Icon.Search}" Width="14" Height="14"
                                  Stretch="Uniform" HorizontalAlignment="Left" Margin="10,0,0,0"
                                  Stroke="{StaticResource Cp.TextFaint}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBox x:Name="SearchBox" Style="{StaticResource Cp.TextBox}" Margin="32,0,30,0"
                                     FontFamily="{DynamicResource Theme.FontFamily}"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Style="{StaticResource Cp.StepButton}" Content="✕" FontSize="11" Width="22" Height="22"
                                    HorizontalAlignment="Right" Margin="0,0,5,0" ToolTip="{loc:T main.clearTheSearchEsc}"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding IsSearching, Converter={StaticResource Cp.BoolToVis}}"/>
                            <TextBlock Text="{loc:T main.searchSettings}" IsHitTestVisible="False" Margin="33,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource Cp.TextFaint}"
                                       FontSize="{StaticResource Cp.Size.Body}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    </DockPanel>

                    <!-- Help at the foot of the rail, apart from the pages you configure: one place for
                         what's new, the changelog and the version. Lit like a rail entry while open. -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Cp.Border}" BorderThickness="0,1,0,0"
                            Padding="8,6">
                        <Button Command="{Binding ShowHelpCommand}" Cursor="Hand" Focusable="False"
                                HorizontalContentAlignment="Stretch" ToolTip="{loc:T main.whatSNewThe}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="7" Height="36" Padding="10,0,8,0">
                                        <Grid>
                                            <Border x:Name="Marker" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                                    Margin="-18,0,0,0" Background="{StaticResource Cp.Accent}" Visibility="Collapsed"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cp.Hover}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsHelpPage}" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Cp.Selected}"/>
                                            <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRailCollapsed}" Value="True">
                                            <Setter TargetName="Chrome" Property="Padding" Value="14,0,0,0"/>
                                            <Setter TargetName="Chrome" Property="ToolTip" Value="{loc:T main.help}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" Style="{StaticResource Cp.Mono}"
                                           FontSize="{StaticResource Cp.Size.Micro}" VerticalAlignment="Center"
                                           Visibility="{Binding IsRailCollapsed, Converter={StaticResource Cp.NotBoolToVis}}"/>
                                <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                      Data="M12,3 A9,9 0 1 0 12.01,3 Z M12,11 V16.5 M12,7.5 V7.51" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{StaticResource Cp.TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHelpPage}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource Cp.Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{loc:T main.help}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="{StaticResource Cp.Size.Body}"
                                           FontWeight="Medium" Foreground="{StaticResource Cp.TextSoft}" Margin="11,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsRailCollapsed, Converter={StaticResource Cp.NotBoolToVis}}"/>
                            </DockPanel>
                        </Button>
                    </Border>

                    <!-- Layouts and the settings pages, pinned above Help so they are always in
                         reach while the widgets above them scroll. -->
                    <ListBox x:Name="PinnedRail" DockPanel.Dock="Bottom" Style="{StaticResource Cp.NavList}"
                             Padding="0,0,0,6" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding PinnedNavView}"
                             SelectedItem="{Binding PinnedRailSelected, Mode=TwoWay}"
                             PreviewMouseLeftButtonUp="Rail_PreviewMouseLeftButtonUp"
                             ItemTemplate="{StaticResource Cp.NavItemTemplate}">
                        <ListBox.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource Cp.NavGroupStyle}"/>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <!-- Grouped on NavItem.Group, so a new section in the rail is a new string in the
                         view model and never a change here. -->
                    <ListBox x:Name="Rail" Style="{StaticResource Cp.NavList}" ItemsSource="{Binding NavView}"
                             SelectedItem="{Binding RailSelected, Mode=TwoWay}"
                             PreviewMouseLeftButtonUp="Rail_PreviewMouseLeftButtonUp"
                             SelectionChanged="Rail_SelectionChanged"
                             ItemTemplate="{StaticResource Cp.NavItemTemplate}">
                        <ListBox.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource Cp.NavGroupStyle}"/>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== Configuration ===== -->
            <DockPanel x:Name="ConfigPane" Grid.Column="1">
                <!-- While searching, the pane shows what matched instead of a page. -->
                <Border DockPanel.Dock="Top" Padding="24,18,22,17" BorderBrush="{StaticResource Cp.Border}" BorderThickness="0,0,0,1"
                        Visibility="{Binding IsSearching, Converter={StaticResource Cp.BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:T main.search}" Style="{StaticResource Cp.Display}"/>
                        <TextBlock Text="{Binding SearchSummary}" Style="{StaticResource Cp.Hint}"
                                   FontSize="{StaticResource Cp.Size.Body}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Top" Padding="24,18,22,17"
                        BorderBrush="{StaticResource Cp.Border}" BorderThickness="0,0,0,1"
                        Visibility="{Binding IsSearching, Converter={StaticResource Cp.NotBoolToVis}}">
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                Background="{StaticResource Cp.SurfaceAlt}" BorderBrush="{StaticResource Cp.Border}"
                                BorderThickness="1" VerticalAlignment="Top">
                            <Path Width="19" Height="19" Stretch="Uniform" Data="{Binding Selected.IconData}"
                                  Stroke="{StaticResource Cp.Accent}" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource Cp.Display}"/>
                            <TextBlock Text="{Binding Selected.Blurb}" Style="{StaticResource Cp.Hint}"
                                       FontSize="{StaticResource Cp.Size.Body}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- The master switch sits with the widget's own title and binds straight to
                             the same slot the rail's switch drives: one piece of state, two places
                             to reach it, no synchronisation code between them. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding HasPreview, Converter={StaticResource Cp.BoolToVis}}">
                            <Ellipse Style="{StaticResource Cp.StateDot}" DataContext="{Binding SelectedWidget}"
                                     Margin="0,0,10,0"/>
                            <TextBlock Text="{loc:T main.showOnScreen}" Style="{StaticResource Cp.Body}"
                                       Foreground="{StaticResource Cp.Text}" Margin="0,0,10,0"
                                       ToolTip="{Binding SelectedWidget.StateLabel}"/>
                            <CheckBox Style="{StaticResource Cp.Switch}"
                                      IsChecked="{Binding SelectedWidget.IsEnabled, Mode=TwoWay}"
                                      ToolTip="{Binding SelectedWidget.StateLabel}"/>
                            <!-- Less common actions on the widget as a whole. -->
                            <Grid Margin="14,0,0,0">
                                <ToggleButton x:Name="WidgetMenuButton" Style="{StaticResource Cp.MenuButton}"
                                              IsChecked="{Binding IsWidgetMenuOpen, Mode=TwoWay}"/>
                                <Popup IsOpen="{Binding IsWidgetMenuOpen, Mode=TwoWay}" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=WidgetMenuButton}" Placement="Bottom"
                                       AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Style="{StaticResource Cp.MenuPopup}">
                                        <StackPanel>
                                            <!-- This widget's options into the same widget in a saved layout. -->
                                            <StackPanel Visibility="{Binding HasWidgetCopyTargets, Converter={StaticResource Cp.BoolToVis}}">
                                                <TextBlock Text="{loc:T main.copySettingsToLayout}" Style="{StaticResource Cp.Eyebrow}" Margin="10,6,10,4"/>
                                                <ItemsControl ItemsSource="{Binding WidgetCopyTargets}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource Cp.MenuItem}" Content="{Binding Label}"
                                                                    Command="{Binding Command}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Height="1" Margin="6,4" Background="{StaticResource Cp.Border}"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource Cp.DangerMenuItem}" Content="{loc:T main.resetToDefaults}"
                                                    Command="{Binding ResetWidgetCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <!-- Tabs, on a page that has them (Help). -->
                    <ListBox Style="{StaticResource Cp.Segmented}" Margin="52,14,0,0"
                             ItemsSource="{Binding Selected.Tabs}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                             Visibility="{Binding Selected.HasTabs, Converter={StaticResource Cp.BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,14,18,24" Focusable="False"
                                  Visibility="{Binding IsSearching, Converter={StaticResource Cp.BoolToVis}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SearchResults}" Focusable="False"
                                          ItemTemplate="{StaticResource Cp.SearchResultTemplate}"/>
                            <TextBlock Text="{loc:T main.tryAWidgetS}"
                                       Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Cp.Hint}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchResults.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto" Padding="24,14,18,24" Focusable="False"
                                  Visibility="{Binding IsSearching, Converter={StaticResource Cp.NotBoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Selected.Settings}"/>
                    </ScrollViewer>

                    <!-- What a big change just did, with Undo while it lasts. -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,18" MaxWidth="560"
                            Background="{StaticResource Cp.SurfaceAlt}" BorderBrush="{StaticResource Cp.BorderStrong}" BorderThickness="1"
                            CornerRadius="8" Padding="16,8,8,8"
                            Visibility="{Binding HasToast, Converter={StaticResource Cp.BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
                        </Border.Effect>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Cp.StepButton}" Content="✕" FontSize="11"
                                    Margin="4,0,0,0" ToolTip="{loc:T main.dismiss}" Command="{Binding DismissToastCommand}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Cp.Button}" Content="{loc:T main.undo}" Height="28" Margin="12,0,0,0"
                                    Command="{Binding Toast.UndoCommand}"
                                    Visibility="{Binding Toast.CanUndo, Converter={StaticResource Cp.BoolToVis}}"/>
                            <TextBlock Text="{Binding Toast.Message}" Style="{StaticResource Cp.Body}" Foreground="{StaticResource Cp.Text}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <GridSplitter x:Name="PaneSplitter" Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="Transparent"
                          BorderBrush="{StaticResource Cp.Border}" BorderThickness="1,0,0,0"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>

            <!-- ===== Preview ===== -->
            <DockPanel x:Name="PreviewPane" Grid.Column="3" Background="#090C0F">
                <Border DockPanel.Dock="Top" Height="42" Padding="18,0"
                        BorderBrush="{StaticResource Cp.Border}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Cp.Live}" Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsHomePage, Converter={StaticResource Cp.NotBoolToVis}}"/>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Cp.Eyebrow}">
                                        <Setter Property="Text" Value="{loc:T main.livePreview}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHomePage}" Value="True">
                                                <Setter Property="Text" Value="{loc:T main.onScreenNow}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasLayoutPreview}" Value="True">
                                                <Setter Property="Text" Value="{loc:T main.layoutPreview}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource Cp.Eyebrow}"
                                   Visibility="{Binding HasPreview, Converter={StaticResource Cp.BoolToVis}}">
                            <Run Text="{loc:T main.size}"/><Run Text="{Binding SelectedWidget.Scale, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding PreviewLayoutResolution}"
                                   Style="{StaticResource Cp.Mono}" FontSize="{StaticResource Cp.Size.Micro}"
                                   Visibility="{Binding HasLayoutPreview, Converter={StaticResource Cp.BoolToVis}}"/>
                    </Grid>
                </Border>

                <!-- How the preview is staged: the session it shows the widget in (or, for Flags, the
                     flag it simulates) and what it is shown over. Sample data only; nothing here
                     reaches the live widget. -->
                <Border DockPanel.Dock="Top" Padding="18,8" BorderBrush="{StaticResource Cp.Border}" BorderThickness="0,0,0,1"
                        Visibility="{Binding HasPreview, Converter={StaticResource Cp.BoolToVis}}">
                    <DockPanel>
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource Cp.Segmented}" VerticalAlignment="Center"
                                 ItemsSource="{Binding BackdropChoices}" SelectedIndex="{Binding BackdropIndex, Mode=TwoWay}"
                                 ToolTip="{loc:T main.whatTheWidgetIs}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding HasPreviewChoices, Converter={StaticResource Cp.BoolToVis}}">
                            <TextBlock Text="{loc:T main.scenario}" Style="{StaticResource Cp.Eyebrow}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Style="{StaticResource Cp.ComboBox}" MinWidth="170" MaxWidth="260" Margin="0,0,12,0"
                                      ItemsSource="{Binding ScenarioChoices}" SelectedIndex="{Binding ScenarioIndex, Mode=TwoWay}"
                                      Visibility="{Binding ShowsScenarioPicker, Converter={StaticResource Cp.BoolToVis}}"
                                      ToolTip="{loc:T main.seeTheWidgetIn}"/>
                            <ComboBox Style="{StaticResource Cp.ComboBox}" MinWidth="170" MaxWidth="260" Margin="0,0,12,0"
                                      ItemsSource="{Binding FlagChoices}" SelectedIndex="{Binding FlagChoiceIndex, Mode=TwoWay}"
                                      Visibility="{Binding ShowsFlagPicker, Converter={StaticResource Cp.BoolToVis}}"
                                      ToolTip="{loc:T main.seeAnyFlagWithout}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <cp:WidgetPreview x:Name="Preview" Slot="{Binding SelectedWidget}"
                                      Visibility="{Binding HasPreview, Converter={StaticResource Cp.BoolToVis}}"/>
                    <cp:LayoutPreview Layout="{Binding PreviewLayout}"
                                      Visibility="{Binding HasLayoutPreview, Converter={StaticResource Cp.BoolToVis}}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="280"
                                Visibility="{Binding ShowsPreviewPlaceholder, Converter={StaticResource Cp.BoolToVis}}">
                        <TextBlock Text="{loc:T main.nothingToPreview}" Style="{StaticResource Cp.Title}"
                                   Foreground="{StaticResource Cp.TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:T main.thisPageConfiguresThe}"
                                   Style="{StaticResource Cp.Hint}" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Home: the screen as it is now, the widgets that are on it drawn where they are. -->
                    <DockPanel Visibility="{Binding IsHomePage, Converter={StaticResource Cp.BoolToVis}}">
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding HomeScreenCaption}" Style="{StaticResource Cp.Hint}"
                                   HorizontalAlignment="Center" Margin="0,0,0,18"/>
                        <cp:LayoutPreview Layout="{Binding HomeScreen}"
                                          EmptyMessage="{loc:T home.preview.empty}"/>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- ===== Status bar =====
             Diagnostics belong here rather than on a page: they describe the running application, so
             they should stay true wherever you happen to be looking. -->
        <Border Grid.Row="2" Height="28" Background="{StaticResource Cp.Rail}"
                BorderBrush="{StaticResource Cp.Border}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Only with the sim connected: without it the line is a row of dashes. -->
                <TextBlock Text="{Binding TelemetryLine}" Style="{StaticResource Cp.Mono}"
                           FontSize="{StaticResource Cp.Size.Micro}" VerticalAlignment="Center"
                           Visibility="{Binding IsConnected, Converter={StaticResource Cp.BoolToVis}}"/>
                <!-- Health first: it is the line that says whether the rest can be trusted. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="24,0,0,0">
                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Cp.Live}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Health}" Value="Degraded">
                                        <Setter Property="Fill" Value="{StaticResource Cp.Warning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Health}" Value="Failed">
                                        <Setter Property="Fill" Value="{StaticResource Cp.Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding HealthLine}" Style="{StaticResource Cp.Mono}" Foreground="{StaticResource Cp.TextSoft}"
                               FontSize="{StaticResource Cp.Size.Micro}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{loc:T main.settingsDiagnosticsHasThe}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DiagnosticsLine}" Style="{StaticResource Cp.Mono}"
                           FontSize="{StaticResource Cp.Size.Micro}"
                           Foreground="{StaticResource Cp.TextFaint}" Margin="18,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <!-- The running version, always in the same corner: the first thing a bug report needs. -->
                <Button Grid.Column="3" Style="{StaticResource Cp.TextButton}" Content="{Binding VersionLabel}"
                        FontSize="{StaticResource Cp.Size.Micro}"
                        ToolTip="{Binding VersionToolTip}" Command="{Binding ShowAboutCommand}"
                        Margin="18,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== Setup assistant =====
             Over the whole window: on a fresh install it is the first thing to do, and it is short. -->
        <Grid Grid.RowSpan="3" Background="#CC07090C" DataContext="{Binding Setup}"
              MouseLeftButtonDown="SetupBackdrop_MouseLeftButtonDown"
              Visibility="{Binding DataContext.IsSetupOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Cp.BoolToVis}}">
            <cp:SetupAssistantView VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"/>
        </Grid>
    </Grid>
</Window>
