<Window x:Class="IRacingOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenOverlay — Control Panel" Height="820" Width="480"
        Icon="Assets/icon.ico"
        Background="#1E1E1E">
    <Window.Resources>
        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB238"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ColumnHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TableCheckBox" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Orientation="Vertical">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Red" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="Waiting for iRacing…" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Widgets: which are enabled, and which should duck out of view while on pit road. -->
            <Border Style="{StaticResource SectionHeaderBorder}">
                <TextBlock Text="WIDGETS" Style="{StaticResource SectionHeaderText}"/>
            </Border>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Show" Style="{StaticResource ColumnHeaderText}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Hide in pit" Style="{StaticResource ColumnHeaderText}" Margin="0,0,0,4"
                           ToolTip="Automatically hides this widget whenever your car is on pit road, without unchecking it — it reappears the moment you leave the pits."/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Relative" Foreground="White" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="RelativeCheckBox" Style="{StaticResource TableCheckBox}"
                          Checked="RelativeCheckBox_Changed" Unchecked="RelativeCheckBox_Changed"/>
                <CheckBox Grid.Row="1" Grid.Column="2" x:Name="RelativeHideInPitCheckBox" Tag="Relative" Style="{StaticResource TableCheckBox}"
                          Checked="HideInPitCheckBox_Changed" Unchecked="HideInPitCheckBox_Changed"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Standings" Foreground="White" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="StandingsCheckBox" Style="{StaticResource TableCheckBox}"
                          Checked="StandingsCheckBox_Changed" Unchecked="StandingsCheckBox_Changed"/>
                <CheckBox Grid.Row="2" Grid.Column="2" x:Name="StandingsHideInPitCheckBox" Tag="Standings" Style="{StaticResource TableCheckBox}"
                          Checked="HideInPitCheckBox_Changed" Unchecked="HideInPitCheckBox_Changed"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Cockpit" Foreground="White" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="CockpitCheckBox" Style="{StaticResource TableCheckBox}"
                          Checked="CockpitCheckBox_Changed" Unchecked="CockpitCheckBox_Changed"/>
                <CheckBox Grid.Row="3" Grid.Column="2" x:Name="CockpitHideInPitCheckBox" Tag="Cockpit" Style="{StaticResource TableCheckBox}"
                          Checked="HideInPitCheckBox_Changed" Unchecked="HideInPitCheckBox_Changed"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Flag" Foreground="White" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="4" Grid.Column="1" x:Name="FlagCheckBox" Style="{StaticResource TableCheckBox}"
                          Checked="FlagCheckBox_Changed" Unchecked="FlagCheckBox_Changed"/>
                <CheckBox Grid.Row="4" Grid.Column="2" x:Name="FlagHideInPitCheckBox" Tag="Flag" Style="{StaticResource TableCheckBox}"
                          Checked="HideInPitCheckBox_Changed" Unchecked="HideInPitCheckBox_Changed"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Tire info" Foreground="White" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="5" Grid.Column="1" x:Name="TireInfoCheckBox" Style="{StaticResource TableCheckBox}"
                          Checked="TireInfoCheckBox_Changed" Unchecked="TireInfoCheckBox_Changed"/>
                <CheckBox Grid.Row="5" Grid.Column="2" x:Name="TireInfoHideInPitCheckBox" Tag="TireInfo" Style="{StaticResource TableCheckBox}"
                          Checked="HideInPitCheckBox_Changed" Unchecked="HideInPitCheckBox_Changed"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Delta" Foreground="White" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="6" Grid.Column="1" x:Name="DeltaCheckBox" Style="{StaticResource TableCheckBox}"
                          Checked="DeltaCheckBox_Changed" Unchecked="DeltaCheckBox_Changed"/>
                <CheckBox Grid.Row="6" Grid.Column="2" x:Name="DeltaHideInPitCheckBox" Tag="Delta" Style="{StaticResource TableCheckBox}"
                          Checked="HideInPitCheckBox_Changed" Unchecked="HideInPitCheckBox_Changed"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Fuel" Foreground="White" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="7" Grid.Column="1" x:Name="FuelCheckBox" Style="{StaticResource TableCheckBox}"
                          Checked="FuelCheckBox_Changed" Unchecked="FuelCheckBox_Changed"/>
                <CheckBox Grid.Row="7" Grid.Column="2" x:Name="FuelHideInPitCheckBox" Tag="Fuel" Style="{StaticResource TableCheckBox}"
                          Checked="HideInPitCheckBox_Changed" Unchecked="HideInPitCheckBox_Changed"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Pedal trace" Foreground="White" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="8" Grid.Column="1" x:Name="PedalTraceCheckBox" Style="{StaticResource TableCheckBox}"
                          Checked="PedalTraceCheckBox_Changed" Unchecked="PedalTraceCheckBox_Changed"/>
                <CheckBox Grid.Row="8" Grid.Column="2" x:Name="PedalTraceHideInPitCheckBox" Tag="PedalTrace" Style="{StaticResource TableCheckBox}"
                          Checked="HideInPitCheckBox_Changed" Unchecked="HideInPitCheckBox_Changed"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Incident" Foreground="White" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="9" Grid.Column="1" x:Name="IncidentCheckBox" Style="{StaticResource TableCheckBox}"
                          Checked="IncidentCheckBox_Changed" Unchecked="IncidentCheckBox_Changed"/>
                <CheckBox Grid.Row="9" Grid.Column="2" x:Name="IncidentHideInPitCheckBox" Tag="Incident" Style="{StaticResource TableCheckBox}"
                          Checked="HideInPitCheckBox_Changed" Unchecked="HideInPitCheckBox_Changed"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Track info" Foreground="White" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="10" Grid.Column="1" x:Name="TrackInfoCheckBox" Style="{StaticResource TableCheckBox}"
                          Checked="TrackInfoCheckBox_Changed" Unchecked="TrackInfoCheckBox_Changed"/>
                <CheckBox Grid.Row="10" Grid.Column="2" x:Name="TrackInfoHideInPitCheckBox" Tag="TrackInfo" Style="{StaticResource TableCheckBox}"
                          Checked="HideInPitCheckBox_Changed" Unchecked="HideInPitCheckBox_Changed"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="Track map" Foreground="White" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="11" Grid.Column="1" x:Name="TrackMapCheckBox" Style="{StaticResource TableCheckBox}"
                          Checked="TrackMapCheckBox_Changed" Unchecked="TrackMapCheckBox_Changed"/>
                <CheckBox Grid.Row="11" Grid.Column="2" x:Name="TrackMapHideInPitCheckBox" Tag="TrackMap" Style="{StaticResource TableCheckBox}"
                          Checked="HideInPitCheckBox_Changed" Unchecked="HideInPitCheckBox_Changed"/>
            </Grid>

            <!-- Standings overlay: which columns show, in the floating widget only (the Dashboard's
                 own Standings panel always shows every column). -->
            <Border Style="{StaticResource SectionHeaderBorder}">
                <TextBlock Text="STANDINGS WIDGET COLUMNS" Style="{StaticResource SectionHeaderText}"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <CheckBox x:Name="StandingsIRatingCheckBox" Content="iR" Foreground="White" Margin="0,0,12,0"
                          Checked="StandingsIRatingCheckBox_Changed" Unchecked="StandingsIRatingCheckBox_Changed"/>
                <CheckBox x:Name="StandingsIRatingDeltaCheckBox" Content="iRΔ" Foreground="White" Margin="0,0,12,0"
                          Checked="StandingsIRatingDeltaCheckBox_Changed" Unchecked="StandingsIRatingDeltaCheckBox_Changed"/>
                <CheckBox x:Name="StandingsLicenseCheckBox" Content="License" Foreground="White" Margin="0,0,12,0"
                          Checked="StandingsLicenseCheckBox_Changed" Unchecked="StandingsLicenseCheckBox_Changed"/>
                <CheckBox x:Name="StandingsLapCheckBox" Content="Lap" Foreground="White" Margin="0,0,12,0"
                          Checked="StandingsLapCheckBox_Changed" Unchecked="StandingsLapCheckBox_Changed"/>
                <CheckBox x:Name="StandingsLastLapCheckBox" Content="Last" Foreground="White" Margin="0,0,12,0"
                          Checked="StandingsLastLapCheckBox_Changed" Unchecked="StandingsLastLapCheckBox_Changed"/>
                <CheckBox x:Name="StandingsBestLapCheckBox" Content="Best" Foreground="White" Margin="0,0,12,0"
                          Checked="StandingsBestLapCheckBox_Changed" Unchecked="StandingsBestLapCheckBox_Changed"/>
                <CheckBox x:Name="StandingsGapCheckBox" Content="Gap" Foreground="White"
                          Checked="StandingsGapCheckBox_Changed" Unchecked="StandingsGapCheckBox_Changed"/>
            </StackPanel>

            <!-- Session display: how telemetry-derived values are computed/read, not what's shown. -->
            <Border Style="{StaticResource SectionHeaderBorder}">
                <TextBlock Text="SESSION DISPLAY" Style="{StaticResource SectionHeaderText}"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Delta reference:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" Width="140"/>
                <ComboBox x:Name="DeltaReferenceComboBox" Width="180" SelectionChanged="DeltaReferenceComboBox_SelectionChanged">
                    <ComboBoxItem Content="Session best lap" IsSelected="True"/>
                    <ComboBoxItem Content="Personal best (all-time)"/>
                    <ComboBoxItem Content="Optimal lap"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Critical refresh rate:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" Width="140"
                           ToolTip="How often the proximity/ABS bars and pedal trace re-read telemetry — independent of everything else."/>
                <ComboBox x:Name="CriticalRefreshComboBox" Width="180" SelectionChanged="CriticalRefreshComboBox_SelectionChanged">
                    <ComboBoxItem Content="Fastest (~30 Hz)"/>
                    <ComboBoxItem Content="Fast (20 Hz)"/>
                    <ComboBoxItem Content="Normal (10 Hz)" IsSelected="True"/>
                    <ComboBoxItem Content="Slow (5 Hz)"/>
                    <ComboBoxItem Content="Slowest (2 Hz)"/>
                </ComboBox>
            </StackPanel>

            <!-- Layout: whether widgets can currently be dragged/resized. -->
            <Border Style="{StaticResource SectionHeaderBorder}">
                <TextBlock Text="LAYOUT" Style="{StaticResource SectionHeaderText}"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <CheckBox x:Name="EditModeCheckBox" Content="Edit layout (drag/resize widgets)" Foreground="White"
                          Checked="EditModeCheckBox_Changed" Unchecked="EditModeCheckBox_Changed"/>
            </StackPanel>

            <!-- Dashboard: the fullscreen second-monitor layout, separate from the floating widgets above. -->
            <Border Style="{StaticResource SectionHeaderBorder}">
                <TextBlock Text="DASHBOARD (SECOND MONITOR)" Style="{StaticResource SectionHeaderText}"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Monitor:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" Width="140"/>
                <ComboBox x:Name="MonitorComboBox" Width="140" Margin="0,0,8,0"/>
                <Button x:Name="ShowDashboardButton" Content="Show dashboard" Click="ShowDashboardButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Theme:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" Width="140"/>
                <ComboBox x:Name="DashboardThemeComboBox" Width="180" SelectionChanged="DashboardThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Classic" IsSelected="True"/>
                    <ComboBoxItem Content="Digital HUD"/>
                    <ComboBoxItem Content="Raw DIY"/>
                </ComboBox>
            </StackPanel>

            <Border Style="{StaticResource SectionHeaderBorder}">
                <TextBlock Text="DEBUG" Style="{StaticResource SectionHeaderText}"/>
            </Border>
            <StackPanel Margin="0,0,0,8">
                <TextBlock x:Name="DebugText" Text="Speed: —   Lap: —   Gear: —" Foreground="#AAAAAA" FontFamily="Consolas" FontSize="12"/>
                <TextBlock x:Name="MemoryText" Text="Memory: — MB" Foreground="#AAAAAA" FontFamily="Consolas" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
