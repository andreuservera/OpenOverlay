<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer tool: runs the coaching analysis over an .ibt file and prints what it found. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>coaching-analyze</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IRacingOverlay.Coaching\IRacingOverlay.Coaching.csproj" />
  </ItemGroup>

</Project>
